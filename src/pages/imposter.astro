---
import BluffIt from '../components/BluffIt';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Bluff It</title></head><body><BluffIt client:load/></body></html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono&family=Outfit:wght@400;600;700;800;900&display=swap');
*{box-sizing:border-box}body{margin:0;background:#17132b;font-family:Outfit,sans-serif}.party-shell{background:#17132b;color:#fffaf2;min-height:100vh;padding:24px;overflow:hidden;position:relative;text-align:center}.party-glow{border-radius:50%;filter:blur(4px);opacity:.8;position:absolute;z-index:0}.glow-one{background:#ff6d9e;height:34rem;left:-16rem;top:-15rem;width:34rem}.glow-two{background:#7257e8;bottom:-18rem;height:42rem;right:-20rem;width:42rem}.party-nav,.party-home,.party-panel{position:relative;z-index:1}.party-nav{display:flex;justify-content:space-between;margin:auto;max-width:1100px}.party-nav a{color:white;font-weight:900;letter-spacing:.13em;text-decoration:none}.party-nav span,.party-eyebrow,small{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.12em}.party-nav span,.party-eyebrow{color:#fbd64b}.party-home,.party-panel{margin:clamp(4rem,12vh,8rem) auto 2rem;max-width:650px}.party-eyebrow{margin:0 0 .9rem;text-transform:uppercase}h1,h2{font-weight:900;letter-spacing:-.06em;line-height:.9;margin:0}h1{font-size:clamp(4.5rem,14vw,8rem)}h1 span{color:#fbd64b}h2{font-size:clamp(2.7rem,8vw,4.8rem)}.party-lede{color:#e9dff6;font-size:1.1rem;line-height:1.5;margin:1.6rem auto 2rem;max-width:510px}.party-card,.party-panel{background:#211b3de8;border:1px solid #ffffff35;border-radius:26px;box-shadow:0 24px 70px #0004;padding:25px}.home-card{text-align:left}label{color:#d8cce9;display:block;font-weight:700;font-size:.9rem}input,textarea{background:#fffaf2;border:0;border-radius:13px;color:#1f1735;font:700 1rem Outfit;padding:15px;width:100%}input{margin-top:8px}textarea{height:120px;margin-top:20px;resize:vertical}button{border:0;cursor:pointer;font:800 1rem Outfit}.party-primary{background:#fbd64b;border-radius:15px;color:#251b40;margin-top:16px;padding:16px 20px;width:100%}.party-primary b{float:right}.party-divider{border-bottom:1px solid #ffffff30;height:12px;margin:16px 0;text-align:center}.party-divider span{background:#211b3d;color:#bdb0d3;padding:0 10px}.party-join{display:flex;gap:9px}.party-join input{margin:0}.party-join button{background:#ff8bb0;border-radius:13px;padding:0 22px}.room-code{background:#fffaf2;border-radius:18px;color:#241a3c;display:inline-flex;flex-direction:column;margin:12px;padding:14px 27px}.room-code strong{font-family:'DM Mono',monospace;font-size:2.4rem;letter-spacing:.18em}.room-qr{align-items:center;background:#ffffff18;border-radius:17px;display:flex;gap:14px;margin:2px auto 14px;max-width:338px;padding:10px;text-align:left}.room-qr img{background:#fff;border-radius:9px;height:76px;padding:4px;width:76px}.room-qr p{color:#dfd4ec;font-size:.8rem;line-height:1.3;margin:0}.player-list{display:flex;flex-wrap:wrap;gap:9px;justify-content:center;margin:18px 0}.player-list span{background:#413267;border-radius:999px;padding:8px 13px}.player-list i{color:#fbd64b;font-style:normal;margin-right:6px}.waiting,.party-error{color:#d9cde9;margin-top:18px}.prompt{background:#fffaf2;border-radius:18px;color:#261d42;padding:25px}.answer-list{display:grid;gap:10px;margin:22px 0;text-align:left}.answer-list div,.reveal-card{background:#fffaf2;border-radius:15px;color:#261d42;padding:14px}.answer-list p{margin:5px 0 0}.vote-clock{background:#fbd64b;border-radius:999px;color:#291b42;display:inline-flex;flex-direction:column;margin-bottom:17px;padding:9px 20px}.vote-clock strong{font-size:2rem}.accuse-grid{display:grid;gap:10px;grid-template-columns:1fr 1fr;margin-top:25px}.accuse-grid button{background:#fffaf2;border-radius:15px;color:#261d42;padding:17px;text-align:left}.accuse-grid strong,.accuse-grid small{display:block}.accuse-grid strong{font-size:1.15rem;margin:4px 0}.spy-icon{font-size:4.2rem}.reveal-card{display:grid;gap:5px;margin:24px auto;max-width:370px}.reveal-card b{color:#d64c84;font-size:2rem}@media(max-width:520px){.party-shell{padding:18px}.party-home,.party-panel{margin-top:4rem}.accuse-grid{grid-template-columns:1fr}}
.player-list i{font-size:0}.player-list i:after{font-size:1.05rem}.player-list span:nth-child(4n+1) i:after{content:'🦖'}.player-list span:nth-child(4n+2) i:after{content:'🦩'}.player-list span:nth-child(4n+3) i:after{content:'👽'}.player-list span:nth-child(4n) i:after{content:'🦄'}.answer-vote{background:#fffaf2;border:0;border-radius:15px;color:#261d42;display:block;font:800 1rem Outfit;padding:16px;text-align:left;width:100%}.answer-vote:hover{background:#fbd64b}.winning-answer{box-shadow:inset 0 0 0 3px #fbd64b}
</style>
