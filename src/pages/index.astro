<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<title>Kayli's Nailz</title>
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}
			body {
				font-family: 'Outfit', sans-serif;
				background: repeating-linear-gradient(
					90deg,
					#f8f9fa,
					#f8f9fa 20px,
					#f1f3f4 20px,
					#f1f3f4 40px
				);
				min-height: 100vh;
				padding: 2rem;
			}
			.container {
				max-width: 500px;
				margin: 0 auto;
			}
			.header {
				text-align: center;
				margin-bottom: 2rem;
			}
			h1 {
				font-size: 2.5rem;
				font-weight: 700;
				color: #0d5c63;
				margin-bottom: 0.25rem;
			}
			.card {
				background: rgba(255, 255, 255, 0.95);
				border-radius: 1.25rem;
				padding: 1.75rem;
				margin-bottom: 1.25rem;
				box-shadow: 0 4px 20px rgba(13, 92, 99, 0.1);
				border: 1px solid rgba(13, 92, 99, 0.08);
			}
			.pricing {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.75rem;
				text-align: center;
			}
			.price-box {
				background: #f8fbfb;
				border: 1px solid rgba(13, 92, 99, 0.12);
				border-radius: 1rem;
				padding: 1rem;
			}
			.price-label {
				display: block;
				color: #1a7f88;
				font-size: 0.95rem;
				margin-bottom: 0.25rem;
				font-weight: 500;
			}
			.price {
				font-size: 1.4rem;
				font-weight: 600;
				color: #0d5c63;
			}
			form h2,
			.card h2 {
				color: #0d5c63;
				margin-bottom: 1.5rem;
				text-align: center;
				font-weight: 600;
				font-size: 1.3rem;
			}
			label,
			.field-label {
				display: block;
				margin-bottom: 0.4rem;
				color: #0d5c63;
				font-weight: 500;
				font-size: 0.9rem;
			}
			input, textarea {
				width: 100%;
				padding: 0.85rem 1rem;
				border: 2px solid #e0e5e6;
				border-radius: 0.75rem;
				margin-bottom: 1rem;
				font-size: 1rem;
				font-family: inherit;
				background: #fafbfb;
				transition: all 0.3s ease;
			}
			input:focus, textarea:focus {
				outline: none;
				border-color: #1a7f88;
				background: white;
				box-shadow: 0 0 0 4px rgba(26, 127, 136, 0.1);
			}
			textarea {
				min-height: 100px;
				resize: vertical;
			}
			input[type='file'] {
				padding: 0.8rem;
			}
			.radio-group {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.75rem;
				margin-bottom: 1rem;
			}
			.radio-option {
				border: 2px solid #e0e5e6;
				border-radius: 0.9rem;
				padding: 0.9rem;
				background: #fafbfb;
			}
			.radio-option label {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin: 0;
				cursor: pointer;
			}
			.radio-option input {
				width: auto;
				margin: 0;
			}
			button {
				width: 100%;
				background: linear-gradient(135deg, #0d5c63, #1a7f88);
				color: white;
				padding: 1rem;
				border: none;
				border-radius: 0.75rem;
				font-size: 1.1rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.3s ease;
				font-family: inherit;
			}
			button:hover {
				transform: translateY(-2px);
				box-shadow: 0 6px 25px rgba(13, 92, 99, 0.3);
			}
			.payment {
				margin-top: 1.25rem;
				color: #1a7f88;
				font-size: 0.85rem;
				text-align: center;
			}
			.footer {
				text-align: center;
				margin-top: 1.5rem;
				color: #0d5c63;
				font-size: 0.85rem;
				opacity: 0.7;
			}
			@media (max-width: 640px) {
				body {
					padding: 1rem;
				}
				.pricing,
				.radio-group {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<div class="container">
			<div class="header">
				<h1>Kayli's Nailz</h1>
			</div>
			
			<div class="card">
				<h2>Pricing</h2>
				<div class="pricing">
					<div class="price-box">
						<span class="price-label">Regular Nails</span>
						<div class="price">$10</div>
					</div>
					<div class="price-box">
						<span class="price-label">Gel X</span>
						<div class="price">$15</div>
					</div>
				</div>
			</div>
			
			<div class="card">
				<form id="booking" name="booking" method="POST" enctype="multipart/form-data" data-netlify="true">
					<input type="hidden" name="form-name" value="booking" />
					<h2>Book an Appointment</h2>
					
					<label for="name">Your Name</label>
					<input type="text" id="name" name="name" placeholder="Name" required />
					
					<label for="phone">Phone Number</label>
					<input type="tel" id="phone" name="phone" placeholder="Best number to text" required />
					
					<label for="appointment-date">When do you want them done?</label>
					<input type="text" id="appointment-date" name="appointment_date" placeholder="Date or timeframe" required />
					
					<div class="field-label">Do you want Gel X?</div>
					<div class="radio-group">
						<div class="radio-option">
							<label for="gelx-yes">
								<input type="radio" id="gelx-yes" name="gel_x" value="Yes" required />
								Yes
							</label>
						</div>
						<div class="radio-option">
							<label for="gelx-no">
								<input type="radio" id="gelx-no" name="gel_x" value="No" />
								No
							</label>
						</div>
					</div>
					
					<label for="inspo">Upload inspo picture</label>
					<input type="file" id="inspo" name="inspo_picture" accept="image/*" />
					
					<label for="comments">Any comments about your design?</label>
					<textarea id="comments" name="comments" placeholder="Colors, gems, charms, simple, extra, or anything else about the design"></textarea>
					
					<button type="submit">Send Request</button>
					
					<p class="payment">Payment by cash or Venmo</p>
				</form>
			</div>
			
			<p class="footer">Made by Kayli</p>
		</div>
	</body>
</html>
