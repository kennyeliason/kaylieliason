<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Kayli&apos;s Nailz</title>
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			:root {
				--rose: #f56ca7;
				--rose-dark: #ca4f84;
				--cream: #fffaf7;
				--peach: #ffe8df;
				--ink: #5c3152;
				--muted: #8b5f7f;
				--line: rgba(197, 103, 146, 0.18);
			}

			body {
				font-family: 'Outfit', sans-serif;
				background:
					radial-gradient(circle at top left, rgba(245, 108, 167, 0.18), transparent 30%),
					radial-gradient(circle at bottom right, rgba(255, 194, 170, 0.26), transparent 35%),
					repeating-linear-gradient(
						90deg,
						#fff9f6,
						#fff9f6 20px,
						#fff1ec 20px,
						#fff1ec 40px
					);
				min-height: 100vh;
				padding: 2rem;
				color: var(--ink);
			}

			.container {
				max-width: 560px;
				margin: 0 auto;
			}

			.header {
				text-align: center;
				margin-bottom: 1.75rem;
			}

			h1 {
				font-size: clamp(2.4rem, 8vw, 3.3rem);
				font-weight: 700;
				color: var(--ink);
				margin-bottom: 0.3rem;
			}

			.tagline {
				font-size: 1.05rem;
				color: var(--muted);
				font-weight: 500;
				letter-spacing: 0.4px;
			}

			.card {
				background: rgba(255, 255, 255, 0.92);
				backdrop-filter: blur(10px);
				border-radius: 1.3rem;
				padding: 1.4rem;
				margin-bottom: 1.15rem;
				box-shadow: 0 10px 30px rgba(197, 103, 146, 0.12);
				border: 1px solid var(--line);
			}

			.card h2,
			form h2 {
				color: var(--ink);
				margin-bottom: 1rem;
				text-align: center;
				font-weight: 600;
				font-size: 1.25rem;
			}

			.click-hint {
				text-align: center;
				color: var(--muted);
				font-size: 0.88rem;
				margin-bottom: 0.8rem;
			}

			.services {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				justify-content: center;
			}

			.service {
				background: linear-gradient(135deg, var(--rose), var(--rose-dark));
				padding: 0.65rem 1.1rem;
				border-radius: 999px;
				color: white;
				font-weight: 600;
				font-size: 0.92rem;
				text-decoration: none;
				box-shadow: 0 8px 16px rgba(245, 108, 167, 0.22);
			}

			.pricing {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.9rem;
			}

			.price-box {
				background: linear-gradient(180deg, var(--cream), var(--peach));
				border: 1px solid var(--line);
				border-radius: 1rem;
				padding: 1rem;
				text-align: center;
			}

			.price-label {
				display: block;
				font-size: 0.95rem;
				color: var(--muted);
				margin-bottom: 0.3rem;
			}

			.price {
				font-size: 1.55rem;
				font-weight: 700;
				color: var(--ink);
			}

			.price-note {
				margin-top: 0.8rem;
				color: var(--muted);
				font-size: 0.92rem;
				text-align: center;
			}

			.form-intro {
				margin: -0.3rem 0 1.15rem;
				text-align: center;
				color: var(--muted);
				font-size: 0.95rem;
			}

			label,
			.field-label {
				display: block;
				margin-bottom: 0.42rem;
				color: var(--ink);
				font-weight: 600;
				font-size: 0.92rem;
			}

			input,
			select,
			textarea {
				width: 100%;
				padding: 0.9rem 1rem;
				border: 2px solid #f2d7e3;
				border-radius: 0.8rem;
				margin-bottom: 1rem;
				font-size: 1rem;
				font-family: inherit;
				background: #fffdfd;
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}

			input:focus,
			select:focus,
			textarea:focus {
				outline: none;
				border-color: var(--rose);
				box-shadow: 0 0 0 4px rgba(245, 108, 167, 0.12);
			}

			textarea {
				min-height: 96px;
				resize: vertical;
			}

			input[type='file'] {
				padding: 0.8rem;
				background: #fff7fb;
			}

			.radio-group {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.75rem;
				margin-bottom: 1rem;
			}

			.radio-option {
				border: 2px solid #f2d7e3;
				border-radius: 1rem;
				padding: 0.9rem;
				background: #fffdfd;
			}

			.radio-option label {
				display: flex;
				align-items: center;
				gap: 0.55rem;
				margin: 0;
				cursor: pointer;
				font-weight: 500;
			}

			.radio-option input {
				width: auto;
				margin: 0;
			}

			.conditional-field[hidden] {
				display: none;
			}

			.helper {
				color: var(--muted);
				font-size: 0.86rem;
				margin: -0.65rem 0 1rem;
			}

			button {
				width: 100%;
				background: linear-gradient(135deg, var(--rose), var(--rose-dark));
				color: white;
				padding: 1rem;
				border: none;
				border-radius: 0.85rem;
				font-size: 1.05rem;
				font-weight: 700;
				cursor: pointer;
				font-family: inherit;
				box-shadow: 0 12px 22px rgba(245, 108, 167, 0.24);
			}

			.venmo {
				margin-top: 1rem;
				color: var(--muted);
				font-size: 0.86rem;
				text-align: center;
			}

			.footer {
				text-align: center;
				margin-top: 1.3rem;
				color: var(--muted);
				font-size: 0.85rem;
			}

			@media (max-width: 640px) {
				body {
					padding: 1rem;
				}

				.card {
					padding: 1.15rem;
				}

				.pricing,
				.radio-group {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<div class="container">
			<div class="header">
				<h1>Kayli&apos;s Nailz</h1>
				<p class="tagline">Cute sets, custom vibes, inspo welcome</p>
			</div>

			<div class="card">
				<p class="click-hint">A few things you can ask for</p>
				<div class="services">
					<span class="service">Freestyle</span>
					<span class="service">French Tips</span>
					<span class="service">Charm Sets</span>
					<span class="service">Birthday Nails</span>
					<span class="service">Simple + Clean</span>
					<span class="service">Custom Inspo</span>
				</div>
			</div>

			<div class="card">
				<h2>Pricing</h2>
				<div class="pricing">
					<div class="price-box">
						<span class="price-label">No Gel-X</span>
						<div class="price">$7</div>
					</div>
					<div class="price-box">
						<span class="price-label">Gel-X</span>
						<div class="price">$10</div>
					</div>
				</div>
				<p class="price-note">Send your idea below and Kayli can confirm details with you.</p>
			</div>

			<div class="card">
				<form
					id="booking"
					name="booking"
					method="POST"
					enctype="multipart/form-data"
					data-netlify="true"
				>
					<input type="hidden" name="form-name" value="booking" />
					<h2>Book a Set</h2>
					<p class="form-intro">Drop your inspo pic, pick your style, and leave your contact info.</p>

					<label for="name">Your Name</label>
					<input type="text" id="name" name="name" placeholder="Name" required />

					<label for="phone">Phone Number</label>
					<input type="tel" id="phone" name="phone" placeholder="Best number to text" required />

					<label for="appointment-date">When do you want them done?</label>
					<input
						type="text"
						id="appointment-date"
						name="appointment_date"
						placeholder="Date or timeframe"
						required
					/>

					<div class="field-label">Do you want Gel-X?</div>
					<div class="radio-group">
						<div class="radio-option">
							<label for="gelx-yes">
								<input type="radio" id="gelx-yes" name="gel_x" value="Yes" required />
								Yes, Gel-X
							</label>
						</div>
						<div class="radio-option">
							<label for="gelx-no">
								<input type="radio" id="gelx-no" name="gel_x" value="No" />
								No Gel-X
							</label>
						</div>
					</div>

					<div id="gelx-follow-up" class="conditional-field" hidden>
						<label for="gelx-style">For Gel-X, do you want them done on-hand or off-hand?</label>
						<select id="gelx-style" name="gel_x_style">
							<option value="">Select one</option>
							<option value="On-hand">Done on-hand</option>
							<option value="Off-hand">Done off-hand</option>
						</select>
					</div>

					<label for="shape">Shape or length</label>
					<input
						type="text"
						id="shape"
						name="shape"
						placeholder="Short square, almond, long coffin, etc."
					/>

					<label for="inspo">Upload inspo picture</label>
					<input type="file" id="inspo" name="inspo_picture" accept="image/*" />
					<p class="helper">If you don&apos;t have a picture, describe the vibe below.</p>

					<label for="design">Describe what you want</label>
					<textarea
						id="design"
						name="design"
						placeholder="Colors, charms, gems, simple or extra, anything you want Kayli to know"
						required
					></textarea>

					<label for="notes">Anything else?</label>
					<textarea
						id="notes"
						name="notes"
						placeholder="Nail size questions, timing, special requests, or allergies"
					></textarea>

					<button type="submit">Send Request</button>

					<p class="venmo">Kayli can text you back to confirm details and payment.</p>
				</form>
			</div>

			<p class="footer">Made by Kayli</p>
		</div>

		<script>
			const gelXOptions = document.querySelectorAll('input[name="gel_x"]');
			const gelXFollowUp = document.getElementById('gelx-follow-up');
			const gelXStyle = document.getElementById('gelx-style');

			const syncGelXFields = () => {
				const selected = document.querySelector('input[name="gel_x"]:checked');
				const wantsGelX = selected?.value === 'Yes';

				if (wantsGelX) {
					gelXFollowUp?.removeAttribute('hidden');
					gelXStyle?.setAttribute('required', 'required');
					return;
				}

				gelXFollowUp?.setAttribute('hidden', 'hidden');
				gelXStyle?.removeAttribute('required');
				if (gelXStyle instanceof HTMLSelectElement) {
					gelXStyle.value = '';
				}
			};

			gelXOptions.forEach((option) => {
				option.addEventListener('change', syncGelXFields);
			});

			syncGelXFields();
		</script>
	</body>
</html>
