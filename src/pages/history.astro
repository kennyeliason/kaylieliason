<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="World history study guide with interactive review games." />
    <meta name="generator" content={Astro.generator} />
    <title>World History Study Guide</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Cormorant+Garamond:wght@400;500;600;700&family=Luckiest+Guy&family=Nunito:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
      :root {
        --sand: #f4ebda;
        --sand-dark: #ddc6a2;
        --ink: #382116;
        --rust: #7a2f24;
        --rust-deep: #541b16;
        --gold: #ba8a4b;
        --card: rgba(250, 245, 235, 0.95);
        --line: rgba(84, 27, 22, 0.14);
        --shadow: 0 24px 55px rgba(52, 32, 21, 0.15);
        --success: #1d6a45;
        --danger: #8d3027;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        font-family: 'Cormorant Garamond', Georgia, serif;
        background:
          radial-gradient(circle at top, rgba(186, 138, 75, 0.18), transparent 30%),
          linear-gradient(180deg, rgba(122, 47, 36, 0.08), transparent 16%),
          linear-gradient(135deg, #f7f0e2 0%, #ead8bc 50%, #dfc8a5 100%);
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.18;
        background-image:
          linear-gradient(rgba(84, 27, 22, 0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(84, 27, 22, 0.04) 1px, transparent 1px);
        background-size: 28px 28px;
      }

      main {
        width: min(1040px, calc(100% - 1.25rem));
        margin: 0 auto;
        padding: 1.25rem 0 3rem;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 2.2rem;
        border: 1px solid rgba(84, 27, 22, 0.18);
        border-radius: 30px;
        background:
          linear-gradient(145deg, rgba(84, 27, 22, 0.96), rgba(122, 47, 36, 0.9)),
          linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent);
        color: #f7f0e2;
        box-shadow: var(--shadow);
      }

      .hero::after {
        content: '';
        position: absolute;
        right: -3rem;
        bottom: -5rem;
        width: 15rem;
        height: 15rem;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(186, 138, 75, 0.24), transparent 70%);
      }

      h1, h2, h3 {
        margin: 0;
        font-family: 'Cinzel', 'Times New Roman', serif;
      }

      h1 {
        margin-top: 1rem;
        font-size: clamp(2.4rem, 5vw, 4.3rem);
        line-height: 0.95;
      }

      .hero-copy {
        max-width: 40rem;
        margin-top: 1rem;
        font-size: clamp(1.15rem, 2vw, 1.42rem);
        line-height: 1.5;
        color: rgba(247, 240, 226, 0.92);
      }

      .menu-wrap {
        margin-top: 1.3rem;
      }

      .unit-switcher {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
      }

      .unit-chip {
        padding: 0.55rem 0.95rem;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        color: #fff8ec;
        cursor: pointer;
        transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
        font-family: 'Cinzel', 'Times New Roman', serif;
        letter-spacing: 0.04em;
        font-size: 0.92rem;
        font-weight: 700;
      }

      .unit-chip:hover {
        transform: translateY(-2px);
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.18);
      }

      .unit-chip.active {
        background: linear-gradient(135deg, rgba(186, 138, 75, 0.28), rgba(84, 27, 22, 0.18));
        border-color: rgba(255, 255, 255, 0.24);
        box-shadow: inset 0 0 0 1px rgba(255, 248, 236, 0.1);
      }

      .menu-label {
        margin: 0 0 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.95rem;
        color: rgba(247, 240, 226, 0.82);
      }

      .mode-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .mode-card {
        width: 100%;
        min-height: 150px;
        padding: 1.2rem;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.08);
        color: #fff8ec;
        text-align: left;
        cursor: pointer;
        transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
      }

      .mode-card:hover {
        transform: translateY(-2px);
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.18);
      }

      .mode-card.active {
        background: linear-gradient(135deg, rgba(186, 138, 75, 0.28), rgba(84, 27, 22, 0.18));
        border-color: rgba(255, 255, 255, 0.24);
        box-shadow: inset 0 0 0 1px rgba(255, 248, 236, 0.1);
      }

      .mode-card strong {
        display: block;
        font-family: 'Cinzel', 'Times New Roman', serif;
        font-size: 1.28rem;
      }

      .mode-card span {
        display: block;
        margin-top: 0.6rem;
        font-size: 1.05rem;
        line-height: 1.4;
        color: rgba(255, 248, 236, 0.88);
      }

      .board {
        margin-top: 1.4rem;
        padding: 1.2rem;
        border-radius: 28px;
        background: rgba(255, 252, 246, 0.58);
        border: 1px solid rgba(84, 27, 22, 0.1);
        box-shadow: 0 18px 42px rgba(52, 32, 21, 0.08);
        backdrop-filter: blur(10px);
      }

      .board[hidden] {
        display: none;
      }

      .panel {
        padding: 1.4rem;
        border-radius: 24px;
        background: var(--card);
        border: 1px solid var(--line);
      }

      :global(.panel-top) {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
      }

      :global(.panel-top p) {
        margin: 0.25rem 0 0;
        font-size: 1rem;
        font-weight: 700;
        color: #5f4d41;
      }

      :global(.panel-top h2),
      :global(.result h2) {
        font-family: 'Cinzel', 'Times New Roman', serif;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        line-height: 1.05;
        color: var(--rust-deep);
      }

      :global(.pill) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.55rem 0.9rem;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--rust), var(--rust-deep));
        color: #fff8ec;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        box-shadow: 0 4px 14px rgba(154,74,54,0.22);
      }

      :global(.progress-track) {
        width: 100%;
        height: 12px;
        border-radius: 999px;
        background: rgba(122, 47, 36, 0.12);
        overflow: hidden;
      }

      :global(.progress-fill) {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--gold), #d7a462);
        transition: width 0.25s ease;
      }

      :global(.question) {
        margin-top: 1rem;
        font-size: 1.28rem;
        line-height: 1.75;
        font-weight: 700;
        color: #2f241e;
        font-family: 'Nunito', 'Trebuchet MS', sans-serif;
        letter-spacing: 0.01em;
      }

      :global(.choices) {
        display: grid;
        gap: 0.85rem;
        margin-top: 1.2rem;
      }

      :global(.choice) {
        width: 100%;
        padding: 1rem 1.05rem;
        border-radius: 16px;
        border: 2px solid transparent;
        background: rgba(255, 255, 255, 0.97);
        color: #2f241e;
        font-size: 1.08rem;
        font-weight: 800;
        line-height: 1.5;
        font-family: 'Nunito', 'Trebuchet MS', sans-serif;
        letter-spacing: 0.01em;
        text-align: left;
        cursor: pointer;
        box-shadow: 0 3px 12px rgba(0,0,0,0.06);
        transition: all 0.2s ease;
      }

      :global(.choice:hover:enabled) { transform: translateY(-2px); filter: brightness(1.02); }
      :global(.choice.correct) { background: rgba(29, 106, 69, 0.12); border-color: rgba(29, 106, 69, 0.38); color: var(--success); }
      :global(.choice.wrong) { background: rgba(141, 48, 39, 0.12); border-color: rgba(141, 48, 39, 0.35); color: var(--danger); }

      :global(.feedback) {
        margin-top: 1rem;
        padding: 1rem;
        border-left: 4px solid var(--gold);
        border-radius: 16px;
        background: rgba(186, 138, 75, 0.12);
      }

      :global(.feedback strong) {
        display: block;
        margin-bottom: 0.35rem;
        color: #4b2f24;
        font-size: 1.02rem;
        font-family: 'Nunito', 'Trebuchet MS', sans-serif;
        font-weight: 800;
      }

      :global(.feedback p) {
        margin: 0;
        font-size: 1.1rem;
        line-height: 1.55;
        color: #3c2b21;
        font-family: 'Nunito', 'Trebuchet MS', sans-serif;
        font-weight: 700;
      }

      :global(.actions) {
        display: flex;
        gap: 0.85rem;
        margin-top: 1.1rem;
        flex-wrap: wrap;
      }

      :global(.btn) {
        border: none;
        border-radius: 999px;
        padding: 0.9rem 1.3rem;
        font-size: 0.95rem;
        font-weight: 800;
        font-family: 'Nunito', 'Trebuchet MS', sans-serif;
        letter-spacing: 0.01em;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      :global(.btn-primary) { background: linear-gradient(135deg, var(--rust), var(--rust-deep)); color: white; box-shadow: 0 4px 14px rgba(122,47,36,0.24); }
      :global(.btn-secondary) { background: rgba(243,244,246,0.85); color: #5f4d41; }
      :global(.btn:hover) { transform: translateY(-2px); }

      :global(.typing-input) {
        width: 100%;
        margin-top: 1.1rem;
        padding: 1rem;
        border-radius: 18px;
        border: 1px solid rgba(84, 27, 22, 0.16);
        background: rgba(255,255,255,0.92);
        color: #374151;
        font-size: 1rem;
        font-family: 'Nunito', 'Trebuchet MS', sans-serif;
        font-weight: 700;
      }

      :global(.typing-help) {
        margin-top: 0.7rem;
        font-size: 1rem;
        color: #5f4d41;
        font-weight: 700;
        font-family: 'Nunito', 'Trebuchet MS', sans-serif;
      }

      :global(.ladder) {
        display: grid;
        gap: 0.45rem;
        margin-top: 1.2rem;
      }

      :global(.ladder-step) {
        padding: 0.75rem 0.9rem;
        border-radius: 14px;
        background: rgba(255,255,255,0.72);
        color: #6f7280;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      }

      :global(.ladder-step.active) {
        background: linear-gradient(135deg, var(--rust), var(--rust-deep));
        color: #fff8ec;
      }

      :global(.jeopardy-grid) {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.6rem;
        margin-top: 1rem;
      }

      :global(.jeopardy-head),
      :global(.jeopardy-cell) {
        padding: 0.9rem 0.55rem;
        border-radius: 16px;
        text-align: center;
      }

      :global(.jeopardy-head) {
        background: linear-gradient(135deg, var(--rust), var(--rust-deep));
        color: #fff8ec;
        font-family: 'Cinzel', 'Times New Roman', serif;
        font-size: 0.82rem;
        font-weight: 800;
      }

      :global(.jeopardy-cell) {
        border: none;
        background: linear-gradient(135deg, #9f4733, #7a2f24);
        color: white;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(159,71,51,0.22);
      }

      :global(.jeopardy-cell.done) {
        background: rgba(255,255,255,0.82);
        color: #8f7669;
        cursor: default;
        box-shadow: none;
      }

      :global(.result) {
        text-align: center;
      }

      :global(.result p) {
        font-size: 1.14rem;
        line-height: 1.45;
      }

      @media (max-width: 760px) {
        main { width: min(100% - 0.75rem, 42rem); padding-top: 0.8rem; }
        .hero { padding: 1.5rem; border-radius: 22px; }
        .mode-grid { grid-template-columns: 1fr; }
        .board { padding: 0.9rem; border-radius: 22px; }
        .panel { padding: 1rem; }
        :global(.jeopardy-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        :global(.jeopardy-head) { display: none; }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="unit-switcher">
          <button class="unit-chip active" data-unit="unit-1" type="button">Unit One • First Peoples + Societies</button>
          <button class="unit-chip" data-unit="unit-2" type="button">Unit Two • 8 Features of Civilizations</button>
        </div>
        <h1>World History Study Guide</h1>
        <p class="hero-copy">Choose your unit and study style and start studying!</p>
        <div class="menu-wrap">
          <p class="menu-label">Choose a mode</p>
          <div class="mode-grid">
            <button class="mode-card" data-mode="multiple" type="button">
              <strong>Multiple Choice</strong>
              <span>Classic one-question practice with instant feedback.</span>
            </button>
            <button class="mode-card" data-mode="jeopardy" type="button">
              <strong>Jeopardy</strong>
              <span>Pick dollar values from a board and clear the whole set.</span>
            </button>
            <button class="mode-card" data-mode="millionaire" type="button">
              <strong>Millionaire</strong>
              <span>Climb the prize ladder one history question at a time.</span>
            </button>
            <button class="mode-card" data-mode="typing" type="button">
              <strong>Typing Quiz</strong>
              <span>Type the answer yourself instead of picking from choices.</span>
            </button>
          </div>
        </div>
      </section>

      <section class="board" id="game-board" hidden>
        <div id="game-root" class="panel"></div>
      </section>
    </main>

    <script type="application/json" id="history-units" set:html={JSON.stringify(studyUnits)}></script>
    <script>
      const units = JSON.parse(document.getElementById('history-units').textContent || '[]');
      const root = document.getElementById('game-root');
      const board = document.getElementById('game-board');
      const modeButtons = Array.from(document.querySelectorAll('[data-mode]'));
      const unitButtons = Array.from(document.querySelectorAll('[data-unit]'));
      const prizeLadder = ['$100', '$200', '$300', '$500', '$1,000', '$2,000', '$4,000', '$8,000', '$16,000', '$32,000'];
      let currentUnit = units[0];

      let state = {};

      function shuffle(items) {
        const copy = [...items];
        for (let i = copy.length - 1; i > 0; i -= 1) {
          const j = Math.floor(Math.random() * (i + 1));
          [copy[i], copy[j]] = [copy[j], copy[i]];
        }
        return copy;
      }

      function normalize(value) {
        return value.toLowerCase().replace(/[^\w\s]/g, ' ').replace(/\s+/g, ' ').trim();
      }

      function currentQuestions() {
        return currentUnit.questions;
      }

      function currentJeopardyCategories() {
        return currentUnit.jeopardyCategories;
      }

      function buildMcQuestions() {
        return currentQuestions().map((item) => ({ ...item, choices: shuffle(item.choices) }));
      }

      function setActiveUnit(unitId) {
        currentUnit = units.find((unit) => unit.id === unitId) || units[0];
        unitButtons.forEach((button) => {
          button.classList.toggle('active', button.dataset.unit === currentUnit.id);
        });
      }

      function setActiveMode(mode) {
        board.hidden = false;
        modeButtons.forEach((button) => {
          button.classList.toggle('active', button.dataset.mode === mode);
        });
      }

      function initMultiple() {
        state = { mode: 'multiple', deck: buildMcQuestions(), index: 0, score: 0, locked: false };
        setActiveMode('multiple');
        renderMultiple();
      }

      function renderMultiple() {
        const item = state.deck[state.index];
        const progress = ((state.index + 1) / state.deck.length) * 100;
        root.innerHTML = `
          <div class="panel-top">
            <div>
              <h2>Multiple Choice</h2>
              <p>Question ${state.index + 1} of ${state.deck.length}</p>
            </div>
            <div class="pill">Score ${state.score}</div>
          </div>
          <div class="progress-track"><div class="progress-fill" style="width:${progress}%"></div></div>
          <div class="question">${item.question}</div>
          <div class="choices">
            ${item.choices.map((choice) => `<button class="choice" data-choice="${escapeHtml(choice)}">${choice}</button>`).join('')}
          </div>
          <div class="feedback" id="feedback" hidden>
            <strong id="feedback-title"></strong>
            <p id="feedback-copy"></p>
          </div>
          <div class="actions">
            <button class="btn btn-primary" id="next-btn" hidden>${state.index === state.deck.length - 1 ? 'See Score' : 'Next Question'}</button>
            <button class="btn btn-secondary" id="restart-btn">Start Over</button>
          </div>
        `;

        root.querySelectorAll('[data-choice]').forEach((button) => {
          button.addEventListener('click', () => handleMultipleChoice(button, button.textContent, item));
        });
        root.querySelector('#restart-btn').addEventListener('click', initMultiple);
      }

      function handleMultipleChoice(button, choice, item) {
        if (state.locked) return;
        state.locked = true;
        const feedback = root.querySelector('#feedback');
        const feedbackTitle = root.querySelector('#feedback-title');
        const feedbackCopy = root.querySelector('#feedback-copy');
        const nextBtn = root.querySelector('#next-btn');
        root.querySelectorAll('[data-choice]').forEach((entry) => {
          entry.disabled = true;
          if (entry.textContent === item.answer) entry.classList.add('correct');
        });
        if (choice === item.answer) {
          state.score += 1;
          button.classList.add('correct');
          feedbackTitle.textContent = 'Correct';
        } else {
          button.classList.add('wrong');
          feedbackTitle.textContent = `Not quite. The answer is ${item.answer}.`;
        }
        feedbackCopy.textContent = item.explanation;
        feedback.hidden = false;
        nextBtn.hidden = false;
        nextBtn.addEventListener('click', () => {
          if (state.index === state.deck.length - 1) {
            renderResult('Multiple Choice', state.score, state.deck.length, initMultiple);
            return;
          }
          state.index += 1;
          state.locked = false;
          renderMultiple();
        }, { once: true });
      }

      function initTyping() {
        state = { mode: 'typing', deck: currentQuestions(), index: 0, score: 0 };
        setActiveMode('typing');
        renderTyping();
      }

      function renderTyping() {
        const item = state.deck[state.index];
        const progress = ((state.index + 1) / state.deck.length) * 100;
        root.innerHTML = `
          <div class="panel-top">
            <div>
              <h2>Typing Quiz</h2>
              <p>Question ${state.index + 1} of ${state.deck.length}</p>
            </div>
            <div class="pill">Score ${state.score}</div>
          </div>
          <div class="progress-track"><div class="progress-fill" style="width:${progress}%"></div></div>
          <div class="question">${item.question}</div>
          <input class="typing-input" id="typing-input" type="text" placeholder="Type your answer here" />
          <div class="typing-help">Short answer is fine. It checks loosely, not word for word.</div>
          <div class="actions">
            <button class="btn btn-primary" id="check-btn">Check Answer</button>
            <button class="btn btn-secondary" id="restart-btn">Start Over</button>
          </div>
          <div class="feedback" id="feedback" hidden>
            <strong id="feedback-title"></strong>
            <p id="feedback-copy"></p>
          </div>
        `;

        const input = root.querySelector('#typing-input');
        const checkBtn = root.querySelector('#check-btn');
        const restartBtn = root.querySelector('#restart-btn');
        checkBtn.addEventListener('click', () => handleTyping(item));
        input.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') handleTyping(item);
        });
        restartBtn.addEventListener('click', initTyping);
      }

      function handleTyping(item) {
        const input = root.querySelector('#typing-input');
        const guess = normalize(input.value);
        if (!guess) return;
        const answer = normalize(item.answer);
        const feedback = root.querySelector('#feedback');
        const feedbackTitle = root.querySelector('#feedback-title');
        const feedbackCopy = root.querySelector('#feedback-copy');
        const ok = guess === answer || guess.includes(answer) || answer.includes(guess);
        if (ok) {
          state.score += 1;
          feedbackTitle.textContent = 'Correct';
          feedbackCopy.textContent = item.explanation;
        } else {
          feedbackTitle.textContent = `Not quite. The answer is ${item.answer}.`;
          feedbackCopy.textContent = item.explanation;
        }
        feedback.hidden = false;
        input.disabled = true;
        root.querySelector('#check-btn').hidden = true;
        const next = document.createElement('button');
        next.className = 'btn btn-primary';
        next.textContent = state.index === state.deck.length - 1 ? 'See Score' : 'Next Question';
        next.addEventListener('click', () => {
          if (state.index === state.deck.length - 1) {
            renderResult('Typing Quiz', state.score, state.deck.length, initTyping);
            return;
          }
          state.index += 1;
          renderTyping();
        }, { once: true });
        root.querySelector('.actions').prepend(next);
      }

      function initMillionaire() {
        state = { mode: 'millionaire', deck: shuffle(currentQuestions()).slice(0, Math.min(10, currentQuestions().length)).map((item) => ({ ...item, choices: shuffle(item.choices) })), index: 0, locked: false };
        setActiveMode('millionaire');
        renderMillionaire();
      }

      function renderMillionaire() {
        const item = state.deck[state.index];
        root.innerHTML = `
          <div class="panel-top">
            <div>
              <h2>Millionaire</h2>
              <p>Answer ten in a row and climb the ladder.</p>
            </div>
            <div class="pill">${prizeLadder[state.index]}</div>
          </div>
          <div class="question">${item.question}</div>
          <div class="choices">
            ${item.choices.map((choice) => `<button class="choice" data-choice="${escapeHtml(choice)}">${choice}</button>`).join('')}
          </div>
          <div class="feedback" id="feedback" hidden>
            <strong id="feedback-title"></strong>
            <p id="feedback-copy"></p>
          </div>
          <div class="ladder">
            ${prizeLadder.slice().reverse().map((step, idx) => {
              const actual = prizeLadder.length - 1 - idx;
              return `<div class="ladder-step ${actual === state.index ? 'active' : ''}">${step}</div>`;
            }).join('')}
          </div>
          <div class="actions">
            <button class="btn btn-secondary" id="restart-btn">Start Over</button>
          </div>
        `;

        root.querySelectorAll('[data-choice]').forEach((button) => {
          button.addEventListener('click', () => handleMillionaireChoice(button, button.textContent, item));
        });
        root.querySelector('#restart-btn').addEventListener('click', initMillionaire);
      }

      function handleMillionaireChoice(button, choice, item) {
        if (state.locked) return;
        state.locked = true;
        const feedback = root.querySelector('#feedback');
        const feedbackTitle = root.querySelector('#feedback-title');
        const feedbackCopy = root.querySelector('#feedback-copy');
        root.querySelectorAll('[data-choice]').forEach((entry) => {
          entry.disabled = true;
          if (entry.textContent === item.answer) entry.classList.add('correct');
        });
        if (choice === item.answer) {
          button.classList.add('correct');
          feedbackTitle.textContent = `Correct. You reached ${prizeLadder[state.index]}.`;
          feedbackCopy.textContent = item.explanation;
          const next = document.createElement('button');
          next.className = 'btn btn-primary';
          next.textContent = state.index === state.deck.length - 1 ? 'Claim Win' : 'Next Question';
          next.addEventListener('click', () => {
            if (state.index === state.deck.length - 1) {
              renderResult('Millionaire', state.deck.length, state.deck.length, initMillionaire, 'You cleared the whole ladder.');
              return;
            }
            state.index += 1;
            state.locked = false;
            renderMillionaire();
          }, { once: true });
          root.querySelector('.actions').prepend(next);
        } else {
          button.classList.add('wrong');
          feedbackTitle.textContent = `Game over. The answer is ${item.answer}.`;
          feedbackCopy.textContent = item.explanation;
          const retry = document.createElement('button');
          retry.className = 'btn btn-primary';
          retry.textContent = 'Play Again';
          retry.addEventListener('click', initMillionaire, { once: true });
          root.querySelector('.actions').prepend(retry);
        }
        feedback.hidden = false;
      }

      function initJeopardy() {
        state = {
          mode: 'jeopardy',
          answered: {},
          activeCell: null,
          score: 0,
        };
        setActiveMode('jeopardy');
        renderJeopardyBoard();
      }

      function renderJeopardyBoard() {
        const jeopardyCategories = currentJeopardyCategories();
        const rowCount = Math.max(...jeopardyCategories.map((category) => category.indexes.length));
        const remaining = currentQuestions().length - Object.keys(state.answered).length;
        root.innerHTML = `
          <div class="panel-top">
            <div>
              <h2>Jeopardy</h2>
              <p>Pick a square and clear the board.</p>
            </div>
            <div class="pill">Score ${state.score}</div>
          </div>
          <div class="jeopardy-grid">
            ${jeopardyCategories.map((category) => `<div class="jeopardy-head">${category.name}</div>`).join('')}
            ${Array.from({ length: rowCount }, (_, row) => jeopardyCategories.map((category) => {
              const questionIndex = category.indexes[row];
              if (questionIndex === undefined) return '<div></div>';
              const key = String(questionIndex);
              const done = state.answered[key];
              return `<button class="jeopardy-cell ${done ? 'done' : ''}" data-j-index="${questionIndex}" ${done ? 'disabled' : ''}>$${(row + 1) * 100}</button>`;
            }).join('')).join('')}
          </div>
          <div class="typing-help">${remaining} square${remaining === 1 ? '' : 's'} left.</div>
        `;

        root.querySelectorAll('[data-j-index]').forEach((button) => {
          button.addEventListener('click', () => openJeopardyQuestion(Number(button.dataset.jIndex)));
        });
      }

      function openJeopardyQuestion(index) {
        const item = { ...currentQuestions()[index], choices: shuffle(currentQuestions()[index].choices) };
        state.activeCell = index;
        root.innerHTML = `
          <div class="panel-top">
            <div>
              <h2>Jeopardy</h2>
              <p>Choose the best answer.</p>
            </div>
            <div class="pill">$${(findJeopardyRow(index) + 1) * 100}</div>
          </div>
          <div class="question">${item.question}</div>
          <div class="choices">
            ${item.choices.map((choice) => `<button class="choice" data-choice="${escapeHtml(choice)}">${choice}</button>`).join('')}
          </div>
          <div class="feedback" id="feedback" hidden>
            <strong id="feedback-title"></strong>
            <p id="feedback-copy"></p>
          </div>
          <div class="actions">
            <button class="btn btn-secondary" id="board-btn">Back to Board</button>
          </div>
        `;

        root.querySelectorAll('[data-choice]').forEach((button) => {
          button.addEventListener('click', () => handleJeopardyChoice(button, button.textContent, item));
        });
        root.querySelector('#board-btn').addEventListener('click', renderJeopardyBoard);
      }

      function handleJeopardyChoice(button, choice, item) {
        const feedback = root.querySelector('#feedback');
        const feedbackTitle = root.querySelector('#feedback-title');
        const feedbackCopy = root.querySelector('#feedback-copy');
        const value = (findJeopardyRow(state.activeCell) + 1) * 100;
        root.querySelectorAll('[data-choice]').forEach((entry) => {
          entry.disabled = true;
          if (entry.textContent === item.answer) entry.classList.add('correct');
        });
        state.answered[String(state.activeCell)] = true;
        if (choice === item.answer) {
          state.score += value;
          button.classList.add('correct');
          feedbackTitle.textContent = `Correct. +$${value}`;
        } else {
          button.classList.add('wrong');
          feedbackTitle.textContent = `Not quite. The answer is ${item.answer}.`;
        }
        feedbackCopy.textContent = item.explanation;
        feedback.hidden = false;

        const actions = root.querySelector('.actions');
        actions.innerHTML = '';

        const next = document.createElement('button');
        next.className = 'btn btn-primary';
        next.textContent = Object.keys(state.answered).length === currentQuestions().length ? 'See Score' : 'Back to Board';
        next.addEventListener('click', () => {
          if (Object.keys(state.answered).length === currentQuestions().length) {
            const jeopardyCategories = currentJeopardyCategories();
            const maxScore = jeopardyCategories.reduce((sum, category) => sum + category.indexes.reduce((inner, _, row) => inner + ((row + 1) * 100), 0), 0);
            renderResult('Jeopardy', state.score, maxScore, initJeopardy, 'Nice. You cleared the whole board.');
            return;
          }
          renderJeopardyBoard();
        }, { once: true });
        actions.append(next);
      }

      function findJeopardyRow(index) {
        const jeopardyCategories = currentJeopardyCategories();
        for (const category of jeopardyCategories) {
          const row = category.indexes.indexOf(index);
          if (row !== -1) return row;
        }
        return 0;
      }

      function renderResult(label, score, total, restartFn, customCopy) {
        root.innerHTML = `
          <div class="result">
            <div class="panel-top">
              <div>
                <h2>${label}</h2>
                <p>Round complete.</p>
              </div>
              <div class="pill">Finished</div>
            </div>
            <div class="question">You got ${score}${label === 'Jeopardy' ? '' : ` out of ${total}`}</div>
            <p>${customCopy || resultCopy(score, total)}</p>
            <div class="actions" style="justify-content:center;">
              <button class="btn btn-primary" id="restart-final">Play Again</button>
            </div>
          </div>
        `;
        root.querySelector('#restart-final').addEventListener('click', restartFn);
      }

      function resultCopy(score, total) {
        if (score === total) return 'Perfect score. You know this unit cold.';
        if (score >= Math.ceil(total * 0.8)) return 'Very solid. A quick rerun and you are locked in.';
        return 'Good start. Another round will help the tricky details stick.';
      }

      function escapeHtml(value) {
        return value.replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
      }

      unitButtons.forEach((button) => {
        button.addEventListener('click', () => {
          setActiveUnit(button.dataset.unit);
          if (state.mode === 'multiple') initMultiple();
          if (state.mode === 'typing') initTyping();
          if (state.mode === 'millionaire') initMillionaire();
          if (state.mode === 'jeopardy') initJeopardy();
        });
      });

      modeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const mode = button.dataset.mode;
          if (mode === 'multiple') initMultiple();
          if (mode === 'typing') initTyping();
          if (mode === 'millionaire') initMillionaire();
          if (mode === 'jeopardy') initJeopardy();
        });
      });

    </script>
  </body>
</html>
