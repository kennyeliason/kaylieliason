<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Unit 1 history quiz for First Peoples and Societies."
    />
    <meta name="generator" content={Astro.generator} />
    <title>History | First Peoples + Societies</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Cormorant+Garamond:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --sand: #eadfc8;
        --sand-light: #f6efdf;
        --clay: #c59a6c;
        --ink: #342015;
        --rust: #7a2f24;
        --rust-deep: #541b16;
        --gold: #b98a4a;
        --card: rgba(248, 242, 230, 0.9);
        --line: rgba(84, 27, 22, 0.18);
        --shadow: 0 20px 50px rgba(52, 32, 21, 0.18);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        font-family: 'Cormorant Garamond', Georgia, serif;
        background:
          radial-gradient(circle at top, rgba(185, 138, 74, 0.22), transparent 28%),
          linear-gradient(180deg, rgba(122, 47, 36, 0.1), transparent 18%),
          linear-gradient(135deg, #f6efdf 0%, #e8d9bc 50%, #d9c3a1 100%);
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.22;
        background-image:
          linear-gradient(rgba(84, 27, 22, 0.06) 1px, transparent 1px),
          linear-gradient(90deg, rgba(84, 27, 22, 0.05) 1px, transparent 1px);
        background-size: 28px 28px;
        mask-image: linear-gradient(180deg, black, rgba(0, 0, 0, 0.35));
      }

      main {
        width: min(1120px, calc(100% - 2rem));
        margin: 0 auto;
        padding: 3rem 0 4rem;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 2.75rem;
        border: 1px solid rgba(84, 27, 22, 0.2);
        border-radius: 28px;
        background:
          linear-gradient(145deg, rgba(84, 27, 22, 0.96), rgba(122, 47, 36, 0.88)),
          linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent);
        color: var(--sand-light);
        box-shadow: var(--shadow);
      }

      .hero::after {
        content: '';
        position: absolute;
        inset: auto -4rem -5rem auto;
        width: 15rem;
        height: 15rem;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(185, 138, 74, 0.24), transparent 70%);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.5rem 0.9rem;
        border-radius: 999px;
        background: rgba(246, 239, 223, 0.08);
        border: 1px solid rgba(246, 239, 223, 0.14);
        font-size: 0.95rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      h1,
      h2 {
        font-family: 'Cinzel', 'Times New Roman', serif;
        margin: 0;
      }

      h1 {
        margin-top: 1rem;
        font-size: clamp(2.5rem, 5vw, 4.8rem);
        line-height: 0.95;
      }

      .hero p {
        max-width: 42rem;
        margin: 1rem 0 0;
        font-size: clamp(1.25rem, 2vw, 1.5rem);
        line-height: 1.5;
        color: rgba(246, 239, 223, 0.9);
      }

      .summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1.75rem;
      }

      .summary-card {
        padding: 1rem 1.1rem;
        border-radius: 18px;
        background: rgba(246, 239, 223, 0.1);
        border: 1px solid rgba(246, 239, 223, 0.12);
