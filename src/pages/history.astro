const questions = [
  {
    question: 'What is an artifact?',
    choices: [
      'An object of historical value made by human beings',
      'A story told by early farmers',
      'A wild plant used for food',
      'A place where people migrated',
    ],
    answer: 'An object of historical value made by human beings',
    explanation: 'Artifacts are human-made objects that help historians learn about the past.',
  },
  {
    question: 'What does migrate mean?',
    choices: [
      'To move from one region to another',
      'To grow crops in one place',
      'To tame wild animals',
      'To build a permanent village',
    ],
    answer: 'To move from one region to another',
    explanation: 'Migration is the movement of people from one area to another.',
  },
  {
    question: 'What is a hunter-gatherer?',
    choices: [
      'A person who survives by hunting game and gathering wild plants',
      'A person who only raises cattle',
      'A leader of a farming village',
      'A person who makes tools from bronze',
