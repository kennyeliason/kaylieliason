---
const studyUnits = [
  {
    id: 'unit-1',
    shortLabel: 'Unit One',
    title: 'First Peoples + Societies',
    description: 'Study early humans, agriculture, domestication, and the first societies.',
    questions: [
  {
    category: 'Vocabulary',
    question: 'What is an artifact?',
    choices: ['An object of historical value made by human beings', 'A wild plant gathered by early people for food', 'A permanent settlement built beside a river', 'A migration path followed by moving groups'],
    answer: 'An object of historical value made by human beings',
    explanation: 'Artifacts are human-made objects that help historians understand the past.',
  },
  {
    category: 'Vocabulary',
    question: 'What does migrate mean?',
    choices: ['To move from one region to another', 'To tame wild animals for farming work', 'To build a village in one location', 'To store extra goods for later use'],
    answer: 'To move from one region to another',
    explanation: 'Migration means people move from one place to another.',
  },
  {
    category: 'Vocabulary',
    question: 'What is a hunter-gatherer?',
    choices: ['A person who survives by hunting game and gathering wild plants', 'A person who grows only wheat for a village', 'A leader who organizes work in a farming village', 'A seller who trades tools from place to place'],
    answer: 'A person who survives by hunting game and gathering wild plants',
    explanation: 'Hunter-gatherers found food in nature instead of raising it through farming.',
  },
  {
    category: 'Vocabulary',
    question: 'What does it mean to adapt?',
    choices: ['To develop characteristics that aid in survival', 'To leave a region forever and never return', 'To invent bronze tools for daily use', 'To stop moving and remain in one place'],
    answer: 'To develop characteristics that aid in survival',
    explanation: 'Adaptation helps living things survive in changing conditions.',
  },
  {
    category: 'Vocabulary',
    question: 'What is agriculture?',
    choices: ['The cultivation of plant foods and the domestication of animals', 'The study of old objects left by earlier people', 'The melting of glaciers during climate change', 'The exchange of only food between families'],
    answer: 'The cultivation of plant foods and the domestication of animals',
    explanation: 'Agriculture means farming plants and raising animals.',
  },
  {
    category: 'Vocabulary',
    question: 'What is domestication?',
    choices: ['The taming of wild animals or controlled cultivation of plants', 'The movement of humans between regions over time', 'The building of roads between early settlements', 'The storage of grain for future seasons'],
    answer: 'The taming of wild animals or controlled cultivation of plants',
    explanation: 'Domestication is the process of bringing plants and animals under human control.',
  },
  {
    category: 'Vocabulary',
    question: 'What is an economy?',
    choices: ['The system of producing and obtaining goods', 'A type of settlement with homes and fields', 'A kind of crop planted during the spring', 'A tool made from bone and sharpened stone'],
    answer: 'The system of producing and obtaining goods',
    explanation: 'An economy is how people make, trade, and use goods.',
  },
  {
    category: 'Vocabulary',
    question: 'What is a surplus?',
    choices: ['A supply of goods or labor not needed for short-term survival', 'A shortage of crops after a hard season', 'A wild animal hunted by early people', 'A kind of migration caused by weather'],
    answer: 'A supply of goods or labor not needed for short-term survival',
    explanation: 'A surplus means there is extra beyond what is needed right away.',
  },
  {
    category: 'Neolithic Revolution',
    question: 'What was the Neolithic Revolution also called?',
    choices: ['The Agricultural Revolution', 'The Ice Revolution of the ancient world', 'The Tool Revolution that changed metalwork', 'The River Revolution centered on waterways'],
    answer: 'The Agricultural Revolution',
    explanation: 'The Neolithic Revolution is another name for the Agricultural Revolution.',
  },
  {
    category: 'Neolithic Revolution',
    question: 'What major change happened during the Neolithic Revolution?',
    choices: ['Humans shifted from hunting and gathering to agriculture and permanent settlements', 'Humans stopped using animals to meet daily needs', 'People left river valleys for colder regions', 'All groups became nomadic and avoided settlements'],
    answer: 'Humans shifted from hunting and gathering to agriculture and permanent settlements',
    explanation: 'This was the big change that reshaped early societies.',
  },
  {
    category: 'Neolithic Revolution',
    question: 'Why were societies able to support larger populations after this shift?',
    choices: ['Agriculture produced a steadier food supply', 'People hunted more game than ever before', 'Everyone moved less and traded less often', 'Glaciers returned and improved growing seasons'],
    answer: 'Agriculture produced a steadier food supply',
    explanation: 'Farming helped feed more people more consistently.',
  },
  {
    category: 'Climate and Change',
    question: 'Why were climate changes around 12,000 BC important?',
    choices: ['The retreat of glaciers changed environments and encouraged agriculture', 'They ended all migration between ancient regions', 'They created bronze tools for farming societies', 'They made all animals tame around humans'],
    answer: 'The retreat of glaciers changed environments and encouraged agriculture',
    explanation: 'Climate change forced people to adjust how they got food.',
  },
  {
    category: 'Climate and Change',
    question: 'Why did agriculture become more important as game decreased?',
    choices: ['People needed a more reliable way to get food', 'Farming required less work than every other job', 'Animals disappeared everywhere across the world', 'Villages banned hunting in all nearby lands'],
    answer: 'People needed a more reliable way to get food',
    explanation: 'As hunting became less dependable, farming became more valuable.',
  },
  {
    category: 'Plants',
    question: 'Which two early grains in the notes were growing wild before being domesticated?',
    choices: ['Wild barley and wheat', 'Rice and corn grown in wet fields', 'Cotton and flax used mostly for cloth', 'Cassava and millet grown in warmer climates'],
    answer: 'Wild barley and wheat',
    explanation: 'The notes point to wild barley and wheat as early domesticated grains.',
  },
  {
    category: 'Plants',
    question: 'How did people improve crop yields and disease resistance over time?',
    choices: ['They used the best grains and mixed different varieties', 'They planted farther from rivers and water sources', 'They used only wild seeds with no selection', 'They stopped farming in groups and worked alone'],
    answer: 'They used the best grains and mixed different varieties',
    explanation: 'Selecting strong plants helped improve crops over time.',
  },
  {
    category: 'Settlements',
    question: 'Why did some nomadic groups choose to settle down?',
    choices: ['Agriculture made permanent communities more practical', 'They lost the ability to hunt for food', 'Animals forced them to stay in one place', 'Trade became illegal between neighboring groups'],
    answer: 'Agriculture made permanent communities more practical',
    explanation: 'Farming encouraged people to stay in one place.',
  },
  {
    category: 'Animals',
    question: 'How were animals domesticated according to the notes?',
    choices: ['Through the ways they interacted with humans', 'By being released into forests near villages', 'By mixing them with crops in farming fields', 'Through bronze tools used by early farmers'],
    answer: 'Through the ways they interacted with humans',
    explanation: 'Animals that worked well around people were more likely to be domesticated.',
  },
  {
    category: 'Animals',
    question: 'Which animal was tamed as early as 12,000 BC?',
    choices: ['Dogs living closely with human groups', 'Cattle raised for milk and heavy labor', 'Goats kept for milk and meat in herds', 'Pigs fed near settlements for later use'],
    answer: 'Dogs living closely with human groups',
    explanation: 'Dogs were among the earliest domesticated animals.',
  },
  {
    category: 'Animals',
    question: 'Which animals were first domesticated between 8500 and 7000 BC?',
    choices: ['Sheep, goats, and pigs', 'Dogs, horses, and chickens kept for transport', 'Cattle, camels, and llamas used as larger animals', 'Wolves, deer, and foxes left as wild animals'],
    answer: 'Sheep, goats, and pigs',
    explanation: 'Those three are specifically listed in the notes for that period.',
  },
  {
    category: 'Animals',
    question: 'When were horned cattle not tamed until?',
    choices: ['About 6500 BC during later domestication', 'About 12,000 BC during very early settlement', 'About 8500 BC during early herding changes', 'About 3000 BC during later ancient empires'],
    answer: 'About 6500 BC during later domestication',
    explanation: 'Horned cattle were domesticated later than several other animals.',
  },
  {
    category: 'Animal Uses',
    question: 'What did animals provide besides meat?',
    choices: ['Milk, hides, wool, and manure that enriched the soil', 'Only bones for decoration in sacred spaces', 'Only transportation across oceans and seas', 'Silver and tools taken from the ground'],
    answer: 'Milk, hides, wool, and manure that enriched the soil',
    explanation: 'Animals were useful for many products beyond meat.',
  },
  {
    category: 'Animal Uses',
    question: 'What were horns and bones used for?',
    choices: ['They were carved to make tools', 'They were planted as crops in prepared fields', 'They were used to track glaciers across regions', 'They were traded for wheat only in markets'],
    answer: 'They were carved to make tools',
    explanation: 'Animal parts could be shaped into useful tools.',
  },
  {
    category: 'Pastoralism',
    question: 'What is pastoralism?',
    choices: ['A way of life based on herding and grazing animals', 'A way of life based only on fishing boats', 'A farming system based only on wheat fields', 'A method of writing laws for governments'],
    answer: 'A way of life based on herding and grazing animals',
    explanation: 'Pastoralism centers on raising and moving with herds.',
  },
  {
    category: 'Regional Impact',
    question: 'Which crops became important in Africa as agriculture spread?',
    choices: ['Cassava, bananas, palm nuts, and millet', 'Wheat, rye, and oats grown in cooler climates', 'Corn, beans, and squash grown in Mesoamerica', 'Olives, grapes, and figs grown near the Mediterranean'],
    answer: 'Cassava, bananas, palm nuts, and millet',
    explanation: 'Those are the crops named in the notes for Africa.',
  },
  {
    category: 'Regional Impact',
    question: 'Which crops are listed in the notes for the Americas?',
    choices: ['Maize, manioc, and sweet potatoes', 'Barley, wheat, and rice grown in Afro-Eurasia', 'Cotton, flax, and millet used for fiber and grain', 'Goats, pigs, and sheep raised as animals'],
    answer: 'Maize, manioc, and sweet potatoes',
    explanation: 'Those are the crops identified in the notes for the Americas.',
  },
    ],
    jeopardyCategories: [
      { name: 'Vocabulary', indexes: [0, 1, 2, 3, 4] },
      { name: 'Revolution', indexes: [5, 8, 9, 10, 12] },
      { name: 'Plants', indexes: [6, 7, 13, 14, 23] },
      { name: 'Animals', indexes: [16, 17, 18, 19, 20] },
      { name: 'Societies', indexes: [11, 15, 21, 22, 24] },
    ],
  },
  {
    id: 'unit-2',
    shortLabel: 'Unit Two',
    title: '8 Features of Civilization',
    description: 'Review the traits that turned growing settlements into full civilizations.',
    questions: [
      {
        category: 'Cities',
        question: 'What helped early farmers grow a surplus of food?',
        choices: ['Improved farming that produced more food than people immediately needed', 'The end of all trade between nearby groups', 'A decrease in population across farming towns', 'A ban on irrigation in farming areas'],
        answer: 'Improved farming that produced more food than people immediately needed',
        explanation: 'A surplus means extra food beyond immediate survival needs.',
      },
      {
        category: 'Cities',
        question: 'What happened to some settlements as food supplies grew?',
        choices: ['They turned into cities with larger populations', 'They disappeared completely after farming improved', 'They became smaller villages only over time', 'They moved into mountains away from rivers'],
        answer: 'They turned into cities',
        explanation: 'More food supported larger populations, which helped settlements grow into cities.',
      },
      {
        category: 'Job Specialization',
        question: 'What is job specialization?',
        choices: ['People focusing on specific jobs and tasks instead of everyone doing everything', 'Everyone farming the same crop in the same way', 'Only leaders being allowed to work for society', 'Moving from city to city for work each season'],
        answer: 'People focusing on specific jobs and tasks instead of everyone doing everything',
        explanation: 'Civilizations needed different people to handle different jobs.',
      },
      {
        category: 'Job Specialization',
        question: 'Which is an example of a specialized job from the notes?',
        choices: ['Teaching, scribing, or stone-cutting', 'Only hunting wild animals for every need', 'Crossing glaciers to search for warmer land', 'Growing one tree at a time for food'],
        answer: 'Teaching, scribing, or stone-cutting',
        explanation: 'The notes list teaching, scribing, and stone-cutting as examples of specialized jobs.',
      },
      {
        category: 'Government',
        question: 'Why did civilizations need organized central governments?',
        choices: ['To manage systems like food supply, irrigation, and waste removal', 'To stop people from building cities and roads', 'To end all religion within the civilization', 'To keep writing from spreading to others'],
        answer: 'To manage systems like food supply, irrigation, and waste removal',
        explanation: 'Governments coordinated the big systems a civilization depended on.',
      },
      {
        category: 'Religion',
        question: 'What role did religious leaders have in complex religions?',
        choices: ['They led rituals to please the gods', 'They built only roads across the civilization', 'They taught everyone to farm the same way', 'They traded all surplus goods for the city'],
        answer: 'They led rituals to please the gods',
        explanation: 'The notes say religious leaders led rituals to please gods.',
      },
      {
        category: 'Writing',
        question: 'Why did civilizations need writing?',
        choices: ['To keep records of trade goods and food storage', 'To decorate every building in the civilization', 'To replace farming tools used in the fields', 'To move cities to new places more easily'],
        answer: 'To keep records of trade goods and food storage',
        explanation: 'Writing helped civilizations track goods, storage, and other important information.',
      },
      {
        category: 'Social Classes',
        question: 'How did specialized jobs affect social classes?',
        choices: ['They helped create a social structure', 'They removed all leaders from the civilization', 'They made everyone equal in social status', 'They ended building work in growing cities'],
        answer: 'They helped create a social structure',
        explanation: 'The notes connect specialized jobs to the growth of social classes.',
      },
      {
        category: 'Public Works',
        question: 'What is a public work?',
        choices: ['A project ordered to benefit the whole community, like a wall or canal', 'A private house built for one family', 'A hunting trip organized for extra food', 'A religious song sung during ceremonies'],
        answer: 'A project ordered to benefit the whole community, like a wall or canal',
        explanation: 'Public works were large projects that helped the civilization survive and function.',
      },
      {
        category: 'Art and Architecture',
        question: 'What did art and architecture show about a civilization?',
        choices: ['Its beliefs, values, beauty, and power', 'Only its food supply from nearby farms', 'Only its weather patterns during each season', 'Its lack of leaders and government systems'],
        answer: 'Its beliefs, values, beauty, and power',
        explanation: 'The notes say art and architecture expressed beliefs and values and could impress people with power and beauty.',
      },
    ],
    jeopardyCategories: [
      { name: 'Cities', indexes: [0, 1] },
      { name: 'Jobs', indexes: [2, 3] },
      { name: 'Government', indexes: [4, 8] },
      { name: 'Beliefs', indexes: [5, 7] },
      { name: 'Writing', indexes: [6, 9] },
    ],
  },
];
