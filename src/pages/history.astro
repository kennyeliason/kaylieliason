        min-width: 3rem;
        padding: 0.45rem 0.7rem;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--rust), var(--rust-deep));
        color: var(--sand-light);
        text-align: center;
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.04em;
