        display: inline-block;
        margin-bottom: 0.45rem;
        color: var(--rust);
        font-size: 0.95rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .question-text {
        font-size: 1.45rem;
        line-height: 1.2;
