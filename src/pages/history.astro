      .answer {
        padding: 0 1.25rem 1.25rem;
      }

      .answer-inner {
        padding: 1rem 1.05rem;
        border-left: 4px solid var(--gold);
        border-radius: 14px;
        background: rgba(185, 138, 74, 0.1);
        font-size: 1.2rem;
        line-height: 1.45;
      }

      .footer-note {
        margin-top: 1.4rem;
        text-align: center;
        color: rgba(84, 27, 22, 0.8);
        font-size: 1.1rem;
      }

      @media (max-width: 820px) {
        main {
          width: min(100% - 1rem, 42rem);
          padding-top: 1rem;
        }

        .hero {
          padding: 1.5rem;
          border-radius: 22px;
        }

        .summary,
        .grid {
          grid-template-columns: 1fr;
        }

