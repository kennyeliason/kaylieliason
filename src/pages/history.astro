    <style>
      :root {
        --sand: #eadfc8;
        --sand-light: #f6efdf;
        --sand-deep: #d6c1a0;
        --ink: #342015;
        --rust: #7a2f24;
        --rust-deep: #541b16;
        --gold: #b98a4a;
        --card: rgba(248, 242, 230, 0.96);
        --line: rgba(84, 27, 22, 0.16);
        --shadow: 0 24px 60px rgba(52, 32, 21, 0.16);
        --success: #1f6b47;
        --error: #8b2d25;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        font-family: 'Cormorant Garamond', Georgia, serif;
        background:
          radial-gradient(circle at top, rgba(185, 138, 74, 0.2), transparent 28%),
          linear-gradient(180deg, rgba(122, 47, 36, 0.08), transparent 18%),
          linear-gradient(135deg, #f6efdf 0%, #eadcc2 50%, #ddc7a5 100%);
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.18;
        background-image:
          linear-gradient(rgba(84, 27, 22, 0.06) 1px, transparent 1px),
          linear-gradient(90deg, rgba(84, 27, 22, 0.05) 1px, transparent 1px);
        background-size: 28px 28px;
        mask-image: linear-gradient(180deg, black, rgba(0, 0, 0, 0.35));
      }

      main {
        width: min(980px, calc(100% - 1.25rem));
        margin: 0 auto;
        padding: 1.25rem 0 3rem;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 2.25rem;
        border: 1px solid rgba(84, 27, 22, 0.2);
        border-radius: 28px;
        background:
          linear-gradient(145deg, rgba(84, 27, 22, 0.96), rgba(122, 47, 36, 0.9)),
          linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent);
        color: var(--sand-light);
        box-shadow: var(--shadow);
      }

      .hero::after {
        content: '';
        position: absolute;
        inset: auto -3rem -5rem auto;
        width: 14rem;
        height: 14rem;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(185, 138, 74, 0.24), transparent 70%);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        padding: 0.55rem 0.95rem;
        border-radius: 999px;
        background: rgba(246, 239, 223, 0.08);
        border: 1px solid rgba(246, 239, 223, 0.14);
        font-size: 0.95rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3 {
        margin: 0;
        font-family: 'Cinzel', 'Times New Roman', serif;
      }

      h1 {
        margin-top: 1rem;
        font-size: clamp(2.4rem, 5vw, 4.5rem);
        line-height: 0.95;
      }

      .hero p {
        max-width: 38rem;
        margin: 1rem 0 0;
        font-size: clamp(1.18rem, 2vw, 1.45rem);
        line-height: 1.5;
        color: rgba(246, 239, 223, 0.92);
      }

      .quiz-shell {
        margin-top: 1.4rem;
        padding: 1.2rem;
        border-radius: 28px;
        background: rgba(255, 252, 246, 0.56);
        border: 1px solid rgba(84, 27, 22, 0.12);
        box-shadow: 0 18px 45px rgba(52, 32, 21, 0.1);
        backdrop-filter: blur(10px);
      }

      .topline {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
      }

      .topline h2 {
        color: var(--rust-deep);
        font-size: clamp(1.45rem, 3vw, 1.9rem);
      }

      .progress-text {
        color: var(--rust);
        font-size: 1.05rem;
        font-weight: 700;
      }

      .progress-track {
        width: 100%;
        height: 12px;
        border-radius: 999px;
        background: rgba(122, 47, 36, 0.12);
        overflow: hidden;
      }

      .progress-fill {
        height: 100%;
        width: 4%;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--gold), #d6a45f);
        transition: width 0.25s ease;
      }

      .question-card {
        margin-top: 1rem;
        padding: 1.55rem;
        border-radius: 24px;
        background: var(--card);
        border: 1px solid var(--line);
      }

      .question-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 4.4rem;
        padding: 0.45rem 0.8rem;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--rust), var(--rust-deep));
        color: var(--sand-light);
        font-size: 0.96rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .question-title {
        margin-top: 1rem;
        font-size: clamp(1.55rem, 3vw, 2.2rem);
        line-height: 1.15;
        color: var(--ink);
      }

      .choices {
        display: grid;
        gap: 0.85rem;
        margin-top: 1.35rem;
      }

      .choice {
        width: 100%;
        padding: 1rem 1.05rem;
        border-radius: 18px;
        border: 1px solid rgba(84, 27, 22, 0.14);
        background: rgba(255, 255, 255, 0.76);
        color: var(--ink);
        font: inherit;
        font-size: 1.18rem;
        text-align: left;
        cursor: pointer;
        transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
      }

      .choice:hover:enabled {
        transform: translateY(-1px);
        border-color: rgba(122, 47, 36, 0.28);
        box-shadow: 0 12px 22px rgba(52, 32, 21, 0.08);
      }

      .choice.correct {
        background: rgba(31, 107, 71, 0.12);
        border-color: rgba(31, 107, 71, 0.45);
        color: var(--success);
      }

      .choice.wrong {
        background: rgba(139, 45, 37, 0.12);
        border-color: rgba(139, 45, 37, 0.35);
        color: var(--error);
      }

      .choice:disabled {
        cursor: default;
      }

      .feedback {
        margin-top: 1.2rem;
        padding: 1rem 1.05rem;
        border-radius: 18px;
        border-left: 4px solid var(--gold);
        background: rgba(185, 138, 74, 0.12);
      }

      .feedback strong {
        display: block;
        margin-bottom: 0.35rem;
        font-size: 1.05rem;
      }

      .feedback p {
        margin: 0;
        font-size: 1.12rem;
        line-height: 1.45;
      }

      .actions {
        display: flex;
        gap: 0.85rem;
        margin-top: 1.25rem;
        flex-wrap: wrap;
      }

      .btn {
        border: none;
        border-radius: 999px;
        padding: 0.9rem 1.4rem;
        font: inherit;
        font-size: 1.02rem;
        font-weight: 700;
        cursor: pointer;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--rust), var(--rust-deep));
        color: var(--sand-light);
      }

      .btn-secondary {
        background: rgba(84, 27, 22, 0.08);
        color: var(--rust-deep);
      }

      .btn:hover {
        transform: translateY(-1px);
      }

      .result {
        margin-top: 1rem;
        padding: 1.7rem;
        border-radius: 24px;
        background: var(--card);
        border: 1px solid var(--line);
        text-align: center;
      }

      .result h2 {
        color: var(--rust-deep);
        font-size: clamp(1.5rem, 3vw, 2rem);
      }

      .result p {
        margin: 0.9rem 0 0;
        font-size: 1.18rem;
        line-height: 1.5;
      }

      @media (max-width: 720px) {
        main {
          width: min(100% - 0.75rem, 42rem);
          padding-top: 0.75rem;
        }

        .hero {
          padding: 1.5rem;
          border-radius: 22px;
        }

        .quiz-shell {
          padding: 0.9rem;
          border-radius: 22px;
        }

        .question-card,
        .result {
          padding: 1.15rem;
          border-radius: 20px;
        }

        .question-title {
          font-size: 1.55rem;
        }

        .choice {
          font-size: 1.08rem;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="eyebrow">Unit One • First Peoples + Societies</div>
        <h1>World History Study Guide</h1>
        <p>
          A quieter, older-world study page for early human societies, migration,
          agriculture, and domestication. Answer one multiple-choice question at a time.
        </p>
      </section>

      <section class="quiz-shell">
        <div class="topline">
          <h2>Question Bank</h2>
          <div class="progress-text" id="progress-text">Question 1 of 25</div>
        </div>
        <div class="progress-track" aria-hidden="true">
          <div class="progress-fill" id="progress-fill"></div>
        </div>

        <article class="question-card" id="question-card">
          <div class="question-number" id="question-number">#1</div>
          <h3 class="question-title" id="question-title"></h3>
          <div class="choices" id="choices"></div>
          <div class="feedback" id="feedback" hidden>
            <strong id="feedback-title"></strong>
            <p id="feedback-copy"></p>
          </div>
          <div class="actions">
            <button class="btn btn-primary" id="next-btn" hidden>Next Question</button>
            <button class="btn btn-secondary" id="restart-btn" hidden>Start Over</button>
          </div>
        </article>

        <article class="result" id="result-card" hidden>
          <h2 id="result-title"></h2>
          <p id="result-copy"></p>
          <div class="actions" style="justify-content:center;">
            <button class="btn btn-primary" id="restart-final-btn">Try Again</button>
          </div>
        </article>
      </section>
    </main>

    <script type="application/json" id="history-questions">{JSON.stringify(questions)}</script>
    <script>
      const questions = JSON.parse(document.getElementById('history-questions').textContent || '[]');
      let questionIndex = 0;
      let score = 0;
      let locked = false;

      const progressText = document.getElementById('progress-text');
      const progressFill = document.getElementById('progress-fill');
      const questionCard = document.getElementById('question-card');
      const resultCard = document.getElementById('result-card');
      const questionNumber = document.getElementById('question-number');
      const questionTitle = document.getElementById('question-title');
      const choices = document.getElementById('choices');
      const feedback = document.getElementById('feedback');
      const feedbackTitle = document.getElementById('feedback-title');
      const feedbackCopy = document.getElementById('feedback-copy');
      const nextBtn = document.getElementById('next-btn');
      const restartBtn = document.getElementById('restart-btn');
      const restartFinalBtn = document.getElementById('restart-final-btn');
      const resultTitle = document.getElementById('result-title');
      const resultCopy = document.getElementById('result-copy');

      function shuffle(items) {
        const copy = [...items];
        for (let i = copy.length - 1; i > 0; i -= 1) {
          const j = Math.floor(Math.random() * (i + 1));
          [copy[i], copy[j]] = [copy[j], copy[i]];
        }
        return copy;
      }

      function setProgress() {
        const current = Math.min(questionIndex + 1, questions.length);
        progressText.textContent = `Question ${current} of ${questions.length}`;
        progressFill.style.width = `${(current / questions.length) * 100}%`;
      }

      function renderQuestion() {
        const item = questions[questionIndex];
        locked = false;
        questionCard.hidden = false;
        resultCard.hidden = true;
        feedback.hidden = true;
        nextBtn.hidden = true;
        restartBtn.hidden = true;

        setProgress();
        questionNumber.textContent = `#${questionIndex + 1}`;
        questionTitle.textContent = item.question;
        choices.innerHTML = '';

        shuffle(item.choices).forEach((choiceText) => {
          const button = document.createElement('button');
          button.className = 'choice';
          button.type = 'button';
          button.textContent = choiceText;
          button.addEventListener('click', () => handleChoice(button, choiceText, item));
          choices.appendChild(button);
        });
      }

      function handleChoice(button, choiceText, item) {
        if (locked) return;
        locked = true;

        const buttons = Array.from(choices.querySelectorAll('.choice'));
        buttons.forEach((entry) => {
          entry.disabled = true;
          if (entry.textContent === item.answer) {
            entry.classList.add('correct');
          }
        });

        if (choiceText === item.answer) {
          score += 1;
          feedbackTitle.textContent = 'Correct';
          feedbackCopy.textContent = item.explanation;
          button.classList.add('correct');
        } else {
          feedbackTitle.textContent = `Not quite. The answer is ${item.answer}.`;
          feedbackCopy.textContent = item.explanation;
          button.classList.add('wrong');
        }

        feedback.hidden = false;

        if (questionIndex === questions.length - 1) {
          nextBtn.textContent = 'See Score';
        } else {
          nextBtn.textContent = 'Next Question';
        }

        nextBtn.hidden = false;
        restartBtn.hidden = false;
      }

      function showResults() {
        questionCard.hidden = true;
        resultCard.hidden = false;
        progressText.textContent = `Final Score: ${score} / ${questions.length}`;
        progressFill.style.width = '100%';
        resultTitle.textContent = `You got ${score} out of ${questions.length}`;

        if (score === questions.length) {
          resultCopy.textContent = 'Perfect score. You definitely know this unit.';
        } else if (score >= Math.ceil(questions.length * 0.8)) {
          resultCopy.textContent = 'Nice job. You are really close, just review the few you missed.';
        } else {
          resultCopy.textContent = 'You have the base down. Run through it again and the hard ones will stick.';
        }
      }

      function nextQuestion() {
        if (questionIndex === questions.length - 1) {
          showResults();
          return;
        }

        questionIndex += 1;
        renderQuestion();
      }

      function restartQuiz() {
        questionIndex = 0;
        score = 0;
        renderQuestion();
      }

      nextBtn.addEventListener('click', nextQuestion);
      restartBtn.addEventListener('click', restartQuiz);
      restartFinalBtn.addEventListener('click', restartQuiz);

      renderQuestion();
    </script>
  </body>
</html>
