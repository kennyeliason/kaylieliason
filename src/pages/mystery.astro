---
import MysteryMansion from '../components/MysteryMansion';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#19243c" />
    <title>Mystery Mansion</title>
  </head>
  <body><MysteryMansion client:load /></body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono&family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;600;700;800&display=swap');
  *{box-sizing:border-box} body{margin:0;background:#19243c;color:#fff8e8;font-family:Manrope,system-ui,sans-serif} button,input,select{font:inherit}.mystery-shell{min-height:100vh;overflow:hidden;padding:24px;position:relative;background:radial-gradient(circle at 12% 0,#314d75 0,transparent 31rem),radial-gradient(circle at 100% 95%,#6b3f4d 0,transparent 34rem),#19243c}.mystery-shell:after{content:"";inset:0;opacity:.1;pointer-events:none;position:absolute;background-image:radial-gradient(#fff 1px,transparent 1px);background-size:18px 18px}.mystery-nav,.mystery-home,.mystery-panel,.game-layout{position:relative;z-index:1}.mystery-nav{display:flex;justify-content:space-between;align-items:center;max-width:1100px;margin:auto}.mystery-nav a{color:#fff8e8;font-size:.9rem;font-weight:800;letter-spacing:.18em;text-decoration:none}.mystery-nav b,.mystery-kicker,small{font-family:'DM Mono',monospace;letter-spacing:.13em}.mystery-nav b{color:#e9bf58;font-size:.72rem}.mystery-home,.mystery-panel{max-width:640px;margin:clamp(4rem,10vh,7rem) auto 2rem;text-align:center}.mystery-kicker{color:#e9bf58;font-size:.7rem;margin:0 0 .9rem;text-transform:uppercase}.mystery-home h1,.mystery-panel h2{font-family:'DM Serif Display',serif;font-size:clamp(3.4rem,10vw,6.5rem);line-height:.84;margin:0}.mystery-home h1 i{color:#e4a6ab}.mystery-home>p:not(.mystery-kicker){color:#d7dfed;font-size:1.08rem;line-height:1.6;margin:1.6rem auto 2rem;max-width:540px}.mystery-card,.mystery-panel{background:rgba(15,25,46,.8);border:1px solid rgba(255,248,232,.23);box-shadow:0 25px 70px #080e1e88}.mystery-card{border-radius:25px;padding:24px;text-align:left}.mystery-card label{color:#d7dfed;font-size:.86rem;font-weight:700}.mystery-card input,.mystery-join input,.case-form select{background:#fff8e8;border:0;border-radius:12px;color:#1f2b43;display:block;font-weight:700;margin-top:8px;outline:3px solid transparent;padding:14px;width:100%}.mystery-card input:focus,.mystery-join input:focus,.case-form select:focus{outline-color:#e9bf58}.mystery-primary{background:#e9bf58;border:0;border-radius:13px;color:#242132;cursor:pointer;font-weight:800;margin-top:15px;padding:15px 18px;width:100%}.mystery-primary:disabled,.mystery-danger:disabled{cursor:not-allowed;opacity:.45}.mystery-primary b{float:right;font-size:1.25rem;line-height:.85}.mystery-or{border-bottom:1px solid #ffffff2b;color:#aebbd1;font-size:.68rem;font-weight:800;letter-spacing:.13em;margin:21px 0 15px;text-align:center}.mystery-or::after{background:#172640;content:''}.mystery-join{display:flex;gap:9px}.mystery-join input{margin:0;letter-spacing:.15em}.mystery-join button{background:#e4a6ab;border:0;border-radius:12px;color:#342530;font-weight:800;padding:0 20px}.mystery-home>small{color:#b8c5dc;display:block;font-size:.65rem;margin-top:20px}.mystery-error{color:#ffbec5;font-size:.9rem;margin:13px auto}.mystery-panel{border-radius:30px;padding:clamp(24px,5vw,48px)}.mystery-panel h2{margin-bottom:15px}.mystery-code{background:#fff8e8;border-radius:16px;color:#22314a;display:inline-flex;flex-direction:column;margin:8px 0 12px;padding:12px 24px}.mystery-code small{color:#718099;font-size:.62rem}.mystery-code strong{font-family:'DM Mono',monospace;font-size:2.4rem;letter-spacing:.2em;margin-left:.2em}.mystery-panel>p{color:#d0dbee;line-height:1.55}.mystery-panel h3{font-family:'DM Serif Display',serif;font-size:1.8rem;margin:24px 0 12px}.character-picks{display:grid;gap:9px;grid-template-columns:repeat(2,1fr)}.character-picks button{background:#f4f0e7;border:3px solid transparent;border-radius:14px;color:#233049;cursor:pointer;display:grid;font-size:.78rem;font-weight:800;gap:2px;padding:11px;text-align:left}.character-picks button span{font-size:1.45rem}.character-picks button small{color:#a65c60;font-size:.55rem}.character-picks button.picked{border-color:var(--character);box-shadow:inset 0 0 0 1px var(--character)}.character-picks button:disabled{opacity:.45}.detective-list{display:flex;flex-wrap:wrap;gap:7px;justify-content:center;margin:18px 0}.detective-list span{background:#3d516f;border-radius:999px;font-size:.76rem;padding:7px 10px}.waiting-text{color:#cdd9ea;font-size:.9rem}.mystery-link{background:transparent;border:0;color:#bfccdf;cursor:pointer;margin-top:16px;text-decoration:underline}.game-layout{display:grid;gap:20px;grid-template-columns:300px minmax(0,650px);justify-content:center;margin:4rem auto 2rem;max-width:1020px}.case-file{align-self:start;background:#efe8d5;border-radius:20px;color:#29364d;padding:18px;transform:rotate(-1deg)}.case-file .mystery-kicker{color:#a4751d}.case-file h3{font-family:'DM Serif Display',serif;font-size:2rem;margin:0 0 14px}.hand{display:grid;gap:9px}.hand-card{background:#fffdf5;border:1px solid #d5c8aa;border-left:7px solid #6b8eb9;border-radius:8px;padding:10px}.hand-card.character{border-left-color:#c8576b}.hand-card.item{border-left-color:#bc8b31}.hand-card small{color:#7e8490;font-size:.55rem;text-transform:uppercase}.hand-card b{display:block;font-family:'DM Serif Display',serif;font-size:1.25rem}.case-note{color:#637187;font-size:.72rem;line-height:1.35}.game-panel{margin:0;max-width:none}.turn-banner{background:#d5e4f5;border-radius:12px;color:#263952;font-size:.7rem;font-weight:800;letter-spacing:.08em;margin:17px 0;padding:10px}.suggestion,.solution,.revealed{background:#fff8e8;border-radius:15px;color:#27364e;display:grid;gap:5px;margin:15px auto;padding:16px}.suggestion small,.solution small,.revealed small{color:#9a6c22;font-size:.57rem}.suggestion strong,.solution strong,.revealed strong{font-family:'DM Serif Display',serif;font-size:2rem}.suggestion span,.solution span{font-style:italic}.suggestion b,.solution b{color:#a14f5b}.revealed{background:#f7dfe1}.revealed p{font-size:.75rem;margin:0}.case-form{display:grid;gap:9px;margin-top:20px}.case-form h3{margin:0;font-size:1.8rem}.case-form select{margin:0}.mystery-danger{background:transparent;border:1px solid #e6a4aa;border-radius:12px;color:#ffd7d9;cursor:pointer;font-weight:800;margin-top:3px;padding:12px}.refute-cards button{background:#f7dfe1;border:0;border-radius:10px;color:#362b3e;cursor:pointer;display:block;font-weight:800;margin:8px auto;padding:12px;width:min(330px,100%)}.case-log{border-top:1px solid #ffffff25;margin-top:24px;padding-top:13px;text-align:left}.case-log small{color:#e9bf58;font-size:.57rem}.case-log p{color:#d6dfec;font-size:.78rem;margin:8px 0}.solved{max-width:550px}.case-icon{font-size:4rem}.solved .solution{margin-top:24px}@media(max-width:760px){.game-layout{grid-template-columns:1fr;margin-top:2rem}.case-file{order:2}.mystery-shell{padding:18px}.mystery-panel{padding:25px 18px}.mystery-home,.mystery-panel{margin-top:4rem}}@media(max-width:400px){.character-picks{grid-template-columns:1fr}}
  .mystery-qr{align-items:center;background:#ffffff14;border-radius:15px;display:flex;gap:13px;margin:2px auto 12px;max-width:315px;padding:10px;text-align:left}.mystery-qr img{background:#fff8e8;border-radius:9px;height:78px;width:78px}.mystery-qr p{color:#d0dbee!important;font-size:.78rem;line-height:1.35;margin:0!important}.mystery-board{display:grid;gap:5px;grid-template-columns:repeat(4,1fr);margin:18px 0}.board-space{background:#ffffff14;border:1px solid #ffffff2d;border-radius:10px;min-height:61px;padding:6px;text-align:center}.board-space small{color:#dce6f3;display:block;font-size:.51rem;line-height:1.05}.board-space span{display:flex;font-size:1.05rem;justify-content:center;margin-top:5px}.board-space i{font-style:normal;margin:0 -2px}.roll-result{color:#e9bf58;font-size:.9rem;margin:3px}.roll-dice{background:#e4a6ab;border:0;border-radius:14px;color:#332534;cursor:pointer;font-size:1.15rem;font-weight:800;margin:3px 0 9px;padding:14px 20px;width:100%}.hand-card{cursor:pointer;text-align:left}.hand-card:not(.revealed-card){background:repeating-linear-gradient(45deg,#314e72,#314e72 6px,#273e5d 6px,#273e5d 12px);border-color:#e9bf58;color:#fff8e8}.hand-card:not(.revealed-card) small{color:#f2d589}.hide-card,.notes-toggle{background:transparent;border:1px solid #9aaac1;border-radius:8px;color:#31435d;cursor:pointer;font-size:.72rem;font-weight:800;margin-top:9px;padding:8px;width:100%}.notes-toggle{background:#31435d;color:#fff8e8}.detective-paper{background:#fffdf5;border:1px dashed #a9854f;margin-top:12px;padding:11px;text-align:left}.detective-paper>strong{display:block;font-family:'DM Serif Display',serif;font-size:1.2rem;margin-bottom:7px}.detective-paper div{border-top:1px solid #ded2bb;margin-top:7px;padding-top:7px}.detective-paper small{color:#9a7742;display:block;font-size:.52rem}.detective-paper label{display:block;font-size:.72rem;margin-top:4px}.detective-paper input{accent-color:#933d52;margin-right:6px}.detective-paper label.crossed{text-decoration:line-through;opacity:.5}
  /* Board-game layout and a side-by-side private case file. */
  .game-layout{grid-template-columns:minmax(420px,500px) minmax(0,650px);max-width:1200px}
  .case-file{display:grid;gap:10px;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);transform:rotate(-.5deg)}
  .case-file>.mystery-kicker,.case-file>h3,.case-file>.case-note{grid-column:1/-1}.case-file .hand{grid-column:1}.case-file .notes-toggle{align-self:end;grid-column:2;margin:0}.case-file .detective-paper{grid-column:2;margin:0}
  .hand-card{cursor:default;text-align:left}.hand-card:not(.revealed-card){background:#fffdf5;border-color:#d5c8aa;color:#29364d}.hand-card:not(.revealed-card) small{color:#7e8490}
  .mystery-board{background:linear-gradient(135deg,#8f6a3d,#e4c982 45%,#8d673e);border:6px solid #38271f;border-radius:15px;box-shadow:inset 0 0 0 2px #efd9a0,0 9px 20px #060b1688;display:grid;gap:4px;grid-template-columns:repeat(5,1fr);grid-template-rows:repeat(5,minmax(58px,1fr));margin:18px 0;padding:9px;position:relative}
  .mansion-center{align-items:center;background:radial-gradient(circle at 35% 30%,#6f4a4d,#352735 68%);border:3px double #e9bf58;box-shadow:inset 0 0 25px #0008;color:#fff2c8;display:flex;font-family:'DM Serif Display',serif;font-size:clamp(1.35rem,3vw,2.15rem);grid-column:2/5;grid-row:2/5;justify-content:center;letter-spacing:.08em;line-height:1.05;text-align:center;text-shadow:0 2px 2px #000}
  .board-space{align-items:center;background:linear-gradient(135deg,#f7e7bd,#d9bb79);border:2px solid #6a4b32;border-radius:3px;display:flex;flex-direction:column;justify-content:center;min-height:0;padding:4px}.board-space small{color:#483525;font-family:'DM Serif Display',serif;font-size:.68rem;letter-spacing:0;line-height:1.02}.board-space span{font-size:.95rem;margin-top:3px}
  .board-space:nth-child(2){grid-column:1;grid-row:5}.board-space:nth-child(3){grid-column:1;grid-row:4}.board-space:nth-child(4){grid-column:1;grid-row:3}.board-space:nth-child(5){grid-column:1;grid-row:2}.board-space:nth-child(6){grid-column:1;grid-row:1}.board-space:nth-child(7){grid-column:2;grid-row:1}.board-space:nth-child(8){grid-column:3;grid-row:1}.board-space:nth-child(9){grid-column:4;grid-row:1}.board-space:nth-child(10){grid-column:5;grid-row:1}.board-space:nth-child(11){grid-column:5;grid-row:2}.board-space:nth-child(12){grid-column:5;grid-row:3}.board-space:nth-child(13){grid-column:5;grid-row:4}
  @media(max-width:760px){.game-layout{grid-template-columns:1fr}.case-file{grid-template-columns:1fr 1fr}.mystery-board{grid-template-rows:repeat(5,55px)}}
  .hand-card{appearance:none;border:1px solid #d5c8aa;border-left:7px solid #6b8eb9;font:inherit}.hand-card.character{border-left-color:#c8576b}.hand-card.item{border-left-color:#bc8b31}.hand-card:hover{box-shadow:0 4px 11px #44331d44;transform:translateY(-1px)}
  .board-space{appearance:none;color:inherit;cursor:default;font:inherit;opacity:1}.board-space:disabled{opacity:1}.board-space span{min-height:1.1rem}.board-space em{display:none}.board-space.move-choice{background:linear-gradient(135deg,#e6fb9c,#a8dd55);box-shadow:0 0 0 3px #f8e468,0 0 18px #f8e468aa;cursor:pointer;z-index:2}.board-space.move-choice:hover{filter:brightness(1.08);transform:scale(1.04)}.board-space.move-choice em{color:#40521e;display:block;font-family:'DM Mono',monospace;font-size:.45rem;font-style:normal;font-weight:800;letter-spacing:.04em;margin-top:2px}
  .mansion-center:before{border:2px solid #c89c4e;content:'';height:52%;position:absolute;transform:rotate(45deg);width:52%}.mansion-center{overflow:hidden;position:relative}.mansion-center br,.mansion-center{isolation:isolate}.mansion-center{z-index:1}.mansion-center::after{color:#f9e2a5;content:'GRAND HALL';font-family:'DM Mono',monospace;font-size:.48rem;letter-spacing:.18em;position:absolute;bottom:15%;z-index:-1}
  .card-viewer{align-items:center;background:#071020f2;display:flex;inset:0;justify-content:center;padding:24px;position:fixed;z-index:30}.giant-card{align-items:center;background:#fffdf5;border:14px solid #d5c8aa;border-left:25px solid #6b8eb9;border-radius:20px;box-shadow:0 28px 90px #000b;color:#29364d;display:flex;flex-direction:column;justify-content:center;max-width:560px;min-height:min(650px,84vh);padding:45px;text-align:center;width:min(92vw,560px)}.giant-card.character{border-left-color:#c8576b}.giant-card.item{border-left-color:#bc8b31}.giant-card small{color:#7e8490;font-size:.7rem;text-transform:uppercase}.giant-card b{font-family:'DM Serif Display',serif;font-size:clamp(3rem,11vw,6.5rem);line-height:.9;margin:24px 0}.giant-card p{color:#637187}.giant-card button{background:#29364d;border:0;border-radius:10px;color:#fff8e8;cursor:pointer;font-weight:800;margin-top:18px;padding:12px 20px}
</style>
