---
import PartyHub from '../components/PartyHub';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#17132b" />
    <title>SideQuest · Game Night</title>
  </head>
  <body>
    <PartyHub client:load />
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono&family=Outfit:wght@400;500;600;700;800;900&display=swap');
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; background: #17132b; font-family: Outfit, system-ui, sans-serif; }
  button, input { font: inherit; }
  .party-shell { background: #17132b; color: #fffaf2; isolation: isolate; min-height: 100vh; overflow: hidden; padding: 24px; position: relative; }
  .party-glow { border-radius: 50%; filter: blur(4px); opacity: .84; position: absolute; z-index: -1; }
  .glow-one { background: #ff6d9e; height: 34rem; left: -16rem; top: -15rem; width: 34rem; }
  .glow-two { background: #7257e8; bottom: -18rem; height: 42rem; right: -20rem; width: 42rem; }
  .party-nav { align-items: center; display: flex; justify-content: space-between; margin: 0 auto; max-width: 1100px; position: relative; }
  .party-nav a { color: #fffaf2; font-size: 1.05rem; font-weight: 900; letter-spacing: .13em; text-decoration: none; }
  .party-nav span, .party-eyebrow, .round-top, small { font-family: 'DM Mono', monospace; font-size: .68rem; letter-spacing: .12em; }
  .party-nav span { color: #fbd64b; }
  .party-home, .party-panel { margin: clamp(4rem, 12vh, 8.5rem) auto 2rem; max-width: 670px; text-align: center; }
  .party-eyebrow { color: #fbd64b; margin: 0 0 .9rem; text-transform: uppercase; }
  h1, h2 { font-weight: 900; letter-spacing: -.06em; line-height: .9; margin: 0; }
  h1 { font-size: clamp(4.5rem, 14vw, 8.8rem); }
  h1 span { color: #fbd64b; }
  h2 { font-size: clamp(2.8rem, 8vw, 5.1rem); }
  .party-lede { color: #e9dff6; font-size: clamp(1.05rem, 2vw, 1.3rem); line-height: 1.5; margin: 1.6rem auto 2rem; max-width: 510px; }
  .party-card, .party-panel { background: rgba(31, 25, 58, .78); border: 1px solid rgba(255,255,255,.2); box-shadow: 0 24px 70px rgba(0,0,0,.22); }
  .home-card { border-radius: 25px; padding: 24px; text-align: left; }
  label { color: #d8cce9; display: block; font-weight: 700; font-size: .92rem; }
  input { background: #fffaf2; border: 0; border-radius: 13px; color: #1f1735; display: block; font-weight: 700; margin-top: 8px; outline: 3px solid transparent; padding: 15px 16px; width: 100%; }
  input:focus { outline-color: #fbd64b; }
  button { border: 0; cursor: pointer; }
  .party-primary { background: #fbd64b; border-radius: 15px; color: #251b40; font-size: 1.06rem; font-weight: 900; margin-top: 16px; padding: 16px 20px; transition: transform .15s; width: 100%; }
  .party-primary:hover:not(:disabled) { transform: translateY(-2px); } .party-primary:disabled { cursor: not-allowed; opacity: .45; }
  .party-primary b { float: right; font-size: 1.35rem; line-height: .75; }
  .party-divider { border-bottom: 1px solid rgba(255,255,255,.2); height: 12px; margin: 16px 0 14px; text-align: center; }.party-divider span { background: #211b3d; color: #bdb0d3; font-size: .8rem; padding: 0 10px; }
  .party-join, .player-entry { display: flex; gap: 9px; }.party-join input, .player-entry input { margin: 0; }.party-join input { letter-spacing: .1em; text-transform: uppercase; }.party-join button, .player-entry button { background: #ff8bb0; border-radius: 13px; color: #251b40; font-weight: 900; padding: 0 22px; }
  .party-note { color: #c9bdde; font-size: .88rem; margin-top: 20px; }.party-note strong { color: #fffaf2; }
  .party-panel { border-radius: 30px; padding: clamp(26px, 5vw, 48px); }.party-panel h2 { margin-bottom: 20px; }
  .room-code { background: #fffaf2; border-radius: 18px; color: #241a3c; display: inline-flex; flex-direction: column; margin: 4px 0 12px; padding: 14px 27px 12px; }.room-code small { color: #715f87; }.room-code strong { font-family: 'DM Mono', monospace; font-size: 2.4rem; letter-spacing: .18em; margin-left: .18em; }
  .lobby-copy { color: #d9cde9; margin: 13px auto 18px; }.player-entry { margin: 0 auto; max-width: 420px; }.player-list { display: flex; flex-wrap: wrap; gap: 9px; justify-content: center; margin: 18px 0 10px; min-height: 34px; }.player-list span { background: #413267; border-radius: 999px; font-weight: 700; padding: 8px 13px; }.player-list i { color: #fbd64b; font-style: normal; margin-right: 6px; }.player-list em { color: #bcaed1; font-size: .9rem; }.party-text { background: transparent; color: #c9bdde; font-size: .85rem; margin-top: 15px; text-decoration: underline; }
  .round-top { color: #cdc0e4; display: flex; justify-content: space-between; margin-bottom: 32px; }.game-panel { max-width: 860px; }.game-instruction { color: #d9cde9; margin: -6px 0 25px; }.choice-grid { display: grid; gap: 14px; grid-template-columns: 1fr 1fr; }.choice { border-radius: 20px; color: #231936; font-size: clamp(1.15rem, 2.4vw, 1.55rem); font-weight: 800; line-height: 1.12; min-height: 215px; padding: 24px; position: relative; text-align: left; transition: transform .16s; }.choice:hover { transform: translateY(-4px) rotate(-.5deg); }.choice small { display: block; margin-bottom: 18px; }.choice b { bottom: 18px; font-size: 1.6rem; position: absolute; right: 22px; }.choice-left { background: #7ee3cf; }.choice-right { background: #ff99b8; }.result-choices { display: grid; gap: 18px; grid-template-columns: 1fr 1fr; text-align: left; }.result-choices div { background: rgba(255,255,255,.12); border-radius: 16px; padding: 17px; }.result-choices small { color: #fbd64b; }.result-choices b { display: block; font-size: 2.8rem; letter-spacing: -.07em; }.result-choices p { color: #ded2ec; font-size: .9rem; line-height: 1.25; margin: 4px 0 0; }.vote-bar { background: #ff99b8; border-radius: 999px; height: 19px; margin: 24px 0 8px; overflow: hidden; }.vote-bar span { background: #7ee3cf; display: block; height: 100%; }.result-caption { color: #c8bbdc; font-size: .85rem; margin: 0; }
  @media (max-width: 520px) { .party-shell { padding: 18px; }.party-home, .party-panel { margin-top: 4.4rem; }.choice-grid, .result-choices { grid-template-columns: 1fr; }.choice { min-height: 145px; }.party-panel { padding: 25px 18px; }.room-code strong { font-size: 2rem; } }
</style>
